    laContrastFade% := GetIntRegistryValue%(key$, "ContrastFade", laContrastFade%);
    laLoc1bXDeg := GetFloatRegistryValue(key$, "Loc1bXDeg", laLoc1bXDeg);
    laLoc1bYDeg := GetFloatRegistryValue(key$, "Loc1bYDeg", laLoc1bYDeg);
    laLoc2aXDeg := GetFloatRegistryValue(key$, "Loc2aXDeg", laLoc2aXDeg);
    laLoc2aYDeg := GetFloatRegistryValue(key$, "Loc2aYDeg", laLoc2aYDeg);
    laLoc2bXDeg := GetFloatRegistryValue(key$, "Loc2bXDeg", laLoc2bXDeg);
    laLoc2bYDeg := GetFloatRegistryValue(key$, "Loc2bYDeg", laLoc2bYDeg);    
    
