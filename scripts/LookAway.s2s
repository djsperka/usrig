trainingStageOptsDS2S2$[0] := "Saccade to S1";
trainingStageOptsDS2S2$[1] := "S2a up after Saccade to S1";
trainingStageOptsDS2S2$[2] := "S2a/b up after Saccade to S1";
trainingStageOptsDS2S2$[3] := "S2a/b, S1 up together";
trainingStageOptsDS2S2$[4] := "S2a/b up before S1";
trainingStageOptsDS2S2$[5] := "Fade out all stimuli";
trainingStageOptsDS2S2$[6] := "Full Task";

var nOptoStages% := 6;
var optoStages$[nOptoStages%];
optoStages$[0] := "Fix: Pre-Stim";  'Holding fixation before Page 1
optoStages$[1] := "Fix: Guide Stim";  'During page 1
optoStages$[2] := "Fix: S1-S2 Gap (GNG only)";  'During Page 2, training step 5-6, GNG only
