''''''''''  Variable Definitions ''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''    

'Experiment Setup Variables
var laExperimentType%;          ' 0-based index to DlgList for experiment selection
var laExperimentLabel$[4];      ' Experiment label for DlgList
laExperimentLabel$[0] := "Single-Saccade GNG";
laExperimentLabel$[1] := "Single-Saccade + Microstim";
laExperimentLabel$[2] := "Double-Saccade, two S1s";
laExperimentLabel$[3] := "Double-Saccade, two S2s";
var laExperimentLabelShort$[4]; ' Short experiment label for registry
laExperimentLabelShort$[0] := "SSGNG";
laExperimentLabelShort$[1] := "SSMicro";
laExperimentLabelShort$[2] := "DS2S1";
laExperimentLabelShort$[3] := "DS2S2";

var nTrainingStageOptsSSGNG% := 5;
var trainingStageOptsSSGNG$[nTrainingStageOptsSSGNG%];
trainingStageOptsSSGNG$[0] := "Saccade to S1 target";
trainingStageOptsSSGNG$[1] := "Introduce S2 target";
trainingStageOptsSSGNG$[2] := "Add Gap between S1/S2 target";
trainingStageOptsSSGNG$[3] := "Fade in S2 distractor";
trainingStageOptsSSGNG$[4] := "Full Task";
'Note that there was a bit of crossed wires in designing this task.  Since there will be no circumstance where
'the animal will be required to saccade to a blank location, there will be no second gap.  There will also not 
'be an explicit saccade release, the animal will "figure out" that it has to go based on the change stimulus.  
'If we decide to ever implement a version where the animal has to saccade to a blank space, we will have to 
'revisit things.


var nTrainingStageOptsSSMicro% := 4;
var trainingStageOptsSSMicro$[nTrainingStageOptsSSMicro%];
trainingStageOptsSSMicro$[0] := "Saccade to target";
trainingStageOptsSSMicro$[1] := "Introduce microstim";
trainingStageOptsSSMicro$[2] := "Fade out target";
trainingStageOptsSSMicro$[3] := "Full Task";

var nTrainingStageOptsDS2S1% := 7;
var trainingStageOptsDS2S1$[nTrainingStageOptsDS2S1%];
trainingStageOptsDS2S1$[0] := "Saccade to S1a";
trainingStageOptsDS2S1$[1] := "S2 up after Saccade to S1a";
trainingStageOptsDS2S1$[2] := "Fade in S1b";
trainingStageOptsDS2S1$[3] := "S2, S1a/b up together";
trainingStageOptsDS2S1$[4] := "S2 up before S1a/b";
trainingStageOptsDS2S1$[5] := "Fade out all stimuli";
trainingStageOptsDS2S1$[6] := "Full Task";

var nTrainingStageOptsDS2S2% := 7;
