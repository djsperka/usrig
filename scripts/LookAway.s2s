var laFixAcquisitionTime;       ' Time allowed to acquire central fixation target before fail trial, seconds
var laFixationDurationMin;		' Time required to maintain central fixation before target presentation begins, seconds (min of range)
var laFixationDurationVar;		' Time required to maintain central fixation before target presentation begins, seconds (variable range)
var laPage1DurationMin;         ' Duration Page 1 is on screen, seconds (min of range)
var laPage1DurationVar;         ' Duration Page 1 is on screen, seconds (variable range)
var laPage2DurationMin;         ' Duration Page 2 is on screen, seconds (min of range)
var laPage2DurationVar;         ' Duration Page 2 is on screen, seconds (variable range)
var laPage3DurationMin;         ' Duration Page 3 is on screen, seconds (min of range)
var laPage3DurationVar;         ' Duration Page 3 is on screen, seconds (variable range)
var laSaccadeReleaseDelayMin;   ' Time to hold between final page DOWN and saccade release, seconds (min of range)
var laSaccadeReleaseDelayVar;   ' Time to hold between final page DOWN and saccade release, seconds (variable range)

var laSacc1AcqTime;             ' Time allowed once released to acquire Location 1, in seconds
var laSacc1HoldTime;            ' Time required to hold Location 1 before saccade to second target allowed.
var laSacc2AcqTime;             ' Time allowed, once arriving at Location 1 (and being released, if applicable), to acquire Location 2, in seconds
var laSacc2HoldTime;            ' Time location 2 must be held before reward, in seconds
var laInterTrialTime;		    ' Blank time following a trial (both successful and failed), seconds
var laAbortPenaltyTime;         ' Penalty time following abort (will then go to ITI)

var laHitsPerSmallReward% := 1; ' For now we will set this to 1, could put it in the dialog if we want
var laMSPerSmallRewardHit%;     ' Setting shorter reward open time for "small rewards"
var laPSmallRewardHoldTarg;     ' Probability of small reward on hold fixation through target presentation
var laPSmallRewardSaccade1;     ' Probability of small reward on correct saccade 1, should instead use full reward on trials with no second saccade
var laPJawsRewardInit;          ' For JAWS trials, we need to reward randomly, will reward at animal's hit rate, but we need an initial value until we can determine hit rate

'Opto variables
var laOptoStartStage%;          ' When does opto start?
var laOptoEndStage%;            ' When does opto end?
var laOptoVoltageOut;           ' Opto voltage level

'Dialog box entry order variables
var laDlgExperimentType%         :=  1;                
var laDlgTrainingStageSSGNG%     :=  2;    
var laDlgTrainingStageSSMicro%   :=  3; 
