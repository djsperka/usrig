var laDlgOptoVoltageOut%         := 41;
var laDlgPJawsRewardInit%        := 42;                                      
var laDlgMSPerSmallRewardHit%    := 43;
var laDlgPSmallRewardHoldTarg%   := 44;
var laDlgPSmallRewardSaccade1%   := 45;

'Dialog box label variables (these dialog labels will change text based on the task/training stage)
var labelNRepeatsLoc1Only$;
var labelNRepeatsLoc1Loc2$;
var labelNRepeatsLoc1ToJF$;
var labelNRepeatsLoc1AwayJF$;
var labelContrastFade$; 
var labelLoc1bXDeg$;
var labelLoc1bYDeg$;
var labelLoc2aXDeg$;
var labelLoc2aYDeg$;
var labelLoc2bXDeg$;
var labelLoc2bYDeg$;    
var labelFixationDurationMin$;
var labelFixationDurationVar$;
