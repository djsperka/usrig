    laPage3DurationMin := GetFloatRegistryValue(key$, "Page3DurationMin", laPage3DurationMin);
    laPage3DurationVar := GetFloatRegistryValue(key$, "Page3DurationVar", laPage3DurationVar);
    laSaccadeReleaseDelayMin := GetFloatRegistryValue(key$, "SaccadeReleaseDelayMin", laSaccadeReleaseDelayMin);
    laSaccadeReleaseDelayVar := GetFloatRegistryValue(key$, "SaccadeReleaseDelayVar", laSaccadeReleaseDelayVar);
    laSacc1AcqTime := GetFloatRegistryValue(key$, "Sacc1AcqTime", laSacc1AcqTime);
    laSacc1HoldTime := GetFloatRegistryValue(key$, "Sacc1HoldTime", laSacc1HoldTime);
    laSacc2AcqTime := GetFloatRegistryValue(key$, "Sacc2AcqTime", laSacc2AcqTime);
    laSacc2HoldTime := GetFloatRegistryValue(key$, "Sacc2HoldTime", laSacc2HoldTime);
    laInterTrialTime := GetFloatRegistryValue(key$, "InterTrialTime", laInterTrialTime);
    laAbortPenaltyTime := GetFloatRegistryValue(key$, "AbortPenaltyTime", laAbortPenaltyTime);
    
    laOptoStartStage% := GetIntRegistryValue%(key$, "OptoStartStage", laOptoStartStage%);
    laOptoEndStage% := GetIntRegistryValue%(key$, "OptoEndStage", laOptoEndStage%);
    laOptoVoltageOut := GetFloatRegistryValue(key$, "OptoVoltageOut", laOptoVoltageOut);
    
    laMSPerSmallRewardHit% := GetIntRegistryValue%(key$, "MSPerSmallRewardHit", laMSPerSmallRewardHit%);
    laPSmallRewardHoldTarg := GetFloatRegistryValue(key$, "PSmallRewardHoldTarg", laPSmallRewardHoldTarg);
    laPSmallRewardSaccade1 := GetFloatRegistryValue(key$, "PSmallRewardSaccade1", laPSmallRewardSaccade1);
    laPJawsRewardInit := GetFloatRegistryValue(key$, "PJawsRewardInit", laPJawsRewardInit);    
    
    'This is hardcoded
    'laHitsPerSmallReward% := GetIntRegistryValue%(key$, "HitsPerSmallReward", laHitsPerSmallReward%);    
    
end;


