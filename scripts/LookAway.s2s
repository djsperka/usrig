var labelPage1DurationVar$;
var labelPage2DurationMin$;
var labelPage2DurationVar$; 
var labelPage3DurationMin$;
var labelPage3DurationVar$; 
var labelSaccadeReleaseDelayMin$;
var labelSaccadeReleaseDelayVar$;

'Dialog box label variable handles (these dialog entries will be toggled on or off)
var hNRepeatsUseJAWS%;
var hNRepeatsNoJAWS%;
var hNRepeatsLoc1Only%;
var hNRepeatsLoc1Loc2%;
var hNRepeatsLoc1ToJF%;
var hNRepeatsLoc1AwayJF%;
var hContrastFade%; 
var hLoc1bXDeg%;
var hLoc1bYDeg%;
var hLoc2aXDeg%;
var hLoc2aYDeg%;
var hLoc2bXDeg%;
var hLoc2bYDeg%;
var hFixationDurationMin%;
var hFixationDurationVar%;
var hPage1DurationMin%;
var hPage1DurationVar%;
var hPage2DurationMin%;
var hPage2DurationVar%; 
var hPage3DurationMin%;
var hPage3DurationVar%;
var hSaccadeReleaseDelayMin%;
var hSaccadeReleaseDelayVar%;
var hSacc1AcqTime%;
var hSacc2AcqTime%;
var hSacc2HoldTime%;
var hOptoVoltageOut%;
var hPJawsRewardInit%;
var hPSmallRewardSaccade1%;

var hTotalTrials%;
var hJAWSFieldLoc%;  'This handle is filled but not actually used

var laTotalTrialsText$;     'Used to place text into the dialog box
var laJAWSFieldLocText$;    'Used to place text into the dialog box

'Non-dialog box variables
var laDoOpto% := 0;                   ' Do optogenetics?
var laDoMicro% := 0;                  ' Do microstim?
var voltageInteger%;                  ' Holds result from vdac32, for passing to sequencer to run opto
var laMaxTrialPerDataPoint% := 100;   ' Seems like more than plenty, used to restrict requested trials at dialog box stage

'Trial variables
const MAXTRIALS% := 5000;
var nTrials%;
var laTarget1Loc%[MAXTRIALS%];                'Trial-by-trial location of saccade target 1; can be 0 (no target, no-go), 1 (target is Loc1a), or 2 (target is Loc1b)
var laTarget2Loc%[MAXTRIALS%];                'Trial-by-trial location of saccade target 2; can be 0 (no saccade 2), 10 (target is Loc2a), or 11 (target is Loc2b)...jumping to 10/11 gives opportunity to draw more stimuli in the S1 period, just in case
var laLocsPresent%[MAXTRIALS%];               'Trial-by-trial indication of locations present, overall.  Is the sum of 1 (Loc1a present), 2 (Loc1b present), 4 (Loc2a present) and 8 (Loc2b present)
var laPage1Draw%[MAXTRIALS%];                 'Trial-by-trial indication of locations present on Page 1, for building trials, drawing in fixation display window, built in same way as laLocsPresent
var laPage2Draw%[MAXTRIALS%];                 'Same, for Page 2
var laPage3Draw%[MAXTRIALS%];                 'Same, for Page 3
var laPage1Fade%[MAXTRIALS%];                 'Trial-by-trial indication of locations faded on Page 1, for building trials, built in same way as laLocsPresent
var laPage2Fade%[MAXTRIALS%];                 'Same, for Page 2
var laPage3Fade%[MAXTRIALS%];                 'Same, for Page 3
var laPage1Ortho%[MAXTRIALS%];                'Trial-by-trial indication of locations in orthogonal on Page 1, for building trials, built in same way as laLocsPresent, relevant in GNG/double saccade
var laPage2Ortho%[MAXTRIALS%];                'Same, for Page 2
var laPage3Ortho%[MAXTRIALS%];                'Same, for Page 3
var laOptoThisTrial%[MAXTRIALS%];             'Trial-by-trial control of whether opto is used
var laMicroThisTrial%[MAXTRIALS%];            'Trial-by-trial control of whether microstim is used
var laInitialST$[MAXTRIALS%];                 'Trial-by-trial initial Sampletext text
'const MAXTARGETPOSITIONS% := 100;             'TODO These variables are for target jitter using the Small Area dialog box, we will probably not be using this, but keep around in case
'var laLoc1Positions[MAXTARGETPOSITIONS%][2];  'possible x,y locations for target 1
'var laLoc2Positions[MAXTARGETPOSITIONS%][2];  'possible x,y locations for target 2
'var laNLoc1Positions% := 0;
'var laNLoc2Positions% := 0;
'var iTargetPoint% := 0;                       'This is an index used to advance the target, not sure how it is different than the trial counter directly above
var laTrialOrder%[MAXTRIALS%];                'The trial order, indices of trials, to be randomized, and we will use it to re-sort all of our trial variables
var tc% := -1;                                'The trial counter, uses zero-index so start at -1, will increment before first use 
var nTrialsStarted%:=0;
var nTrialsSuccess%:=0;
var nTrialsFail%:=0;
var nTrialsAbort% := 0;
var nTrialsStartedJAWS%:=0;                   'Keep separate JAWS/No-JAWS stats so we can determine average reward rate on either
var nTrialsSuccessJAWS%:=0;                   '     as we need to keep a careful eye on percentage of rewards in JAWS case, don't
var nTrialsFailJAWS%:=0;                      '     want that to be very different from No-JAWS case as the animal isn't supposed 
var nTrialsAbortJAWS% := 0;                   '     to figure out what's going on (no stimuli remain on screen)
var nTrialsStartedNoJAWS%:=0;
var nTrialsSuccessNoJAWS%:=0;
var nTrialsFailNoJAWS%:=0;
var nTrialsAbortNoJAWS% := 0;
var pctSuccessJAWS;
var pctSuccessNoJAWS;
'var nTrialsStartedByTarget%[MAXTARGETPOSITIONS%];  'TODO - these are also related to target jitter...
'var nTrialsSuccessByTarget%[MAXTARGETPOSITIONS%];
'var nTrialsFailByTarget%[MAXTARGETPOSITIONS%];
var laPJawsReward;                            'For calculating the JAWS reward probability inside the idle loop

'Eye trace variables
'const MAXEYETRACECOLORS% := 12;
'var laEyeTraceColors%[MAXEYETRACECOLORS%];    ' These are used to draw eyetraces


'Idle loop variables, some of these are similar to dialog box variables but are updated trial-to-trial
var laFixationDuration;			' Time required to maintain central fixation, seconds, randomized trial-to-trial
var laDoOptoThisTrial% := 0;    ' Keep track of trial-by-trial opto
var laDoMicroThisTrial% := 0;   ' Keep track of whether we do microstim trial-by-trial
var laTrialFinalPage%;          ' Determine the final page on this trial, is updated trial-by-trial in stateStartTrial for training step 2 on double saccades (can do either 1 or 2 stimuli)
var laDoTwoSaccades%;           ' If 1, wait for second saccade, wait always happens after fixation down
var laFixDownAfterPage%;        ' After which page does the fixation come down, typically final page except training 2/3 for double saccade
var laSaccadeToBlank%;          ' Set to 1 for final training stage, in this stage "X" will not have a page to bring down
var looking%;                   ' Will keep track of most recent target location viewed
var optoIsOn%;                  ' Keep track of if the laser is actually on
'var laOptoOffMidStimTime;       ' Used to turn off the opto laser mid-stimulus, if required by the timing (is this relevant?)
var Pause% := 0;		        ' When 1, expt is paused - no idle processing done
var tNow := 0;		            ' Latest time for which there are values recorded
var tLast := -1;		        ' Last time we checked for a trigger 
'var xEye, yEye;		            ' Current eye position, now declared in UsreyDAQ
var tLastUpdate := -1;	        ' Last time view was updated
var vTrigger;		            ' Set by NextTime to indicate trigger transition
'var tLastTrigger := -1;	        ' Most recent known trigger time; new triggers have to be greater than this - Note that this is really only useful if ony ONE trigger line is being checked, otherwise need a separate value for each trigger line
var tTrigger := -1;	            ' Variable for newly discovered trigger times
var tFall;                      ' Need a variable to hold the fall time when detecting a pulse
var tAdvance;                   ' Time of advance
var tLastAdvance;               ' Time of last known advance
var tSaccadeStart;              ' Time we noticed a saccade started, only allow ~300 ms to find target, to prevent random looking
var saccadeMaxDur := 0.3;       ' Maximum time saccade is allowed to take, to prevent random looking, currently only enforced on saccade 2 for whatever reason
var tic;                        ' Bin size on the advance channel, used to prevent finding the same advance twice
var HBCycle% := 1;              ' Heartbeat cycle - used to put timing markers into eyetracker output files
'var isAbort%:=0;                'Keep track of if this trial was aborted, for state logic, unused
var laPageToggle%;              'Keep track of the state of the page toggle.  Page toggle will be reset to 0 by both "X" and "S".
var laPage1Dur;                 'Set page durations trial-by-trial, for each relevant page
var laPage2Dur;
var laPage3Dur;
var laSaccadeReleaseDelay;      'Set Saccade release delay trial-by-trial
var optoOnState%;               'Set opto on state for this expt
var optoOffState%;              'Set opto off state for this expt
var TrialStartText$;            'Holds text to use in trial start sampletext
var SequencerPeriodMS;          'Collected but currently unused


'Idle loop state variables
const stateVSGWait%					:= 0;		' wait for vsg to send ready signal
const stateStartTrial%				:= 1;   
const stateWaitForFixPtOn%			:= 2;   
const stateWaitForAcquisition%	    := 3;   
const stateHoldFixation%			:= 4;   
const stateWaitForPage1Up%          := 5;
const stateWaitThroughPage1%        := 6;
const stateWaitForPage2Up%          := 7;
const stateWaitThroughPage2%        := 8;
const stateWaitForPage3Up%          := 9;
const stateWaitThroughPage3%        := 10;
const stateWaitForFinalBlankUp%     := 11;
const stateWaitForSaccadeRelease%   := 12;
const stateWaitSaccade1%            := 13;
const stateHoldSaccade1%            := 14;
const stateWaitSaccade2%            := 15;
const stateHoldSaccade2%            := 16;

const stateGiveMicrostim%           := 23;   'These states are just placeholders for now
const stateWaitSaccadeMicro%        := 24;

const stateSuccess%					:= 91;   'Just numbering these high for now
const stateFailure%					:= 92;
const stateAbort%			        := 93;
const stateAbortPenalty%	        := 94;
const stateAdvance%                 := 95;
const stateCheckAdvance%            := 96;
const stateITI%		 		        := 97;
const stateWaitForBlank%		    := 98;
const stateWaitForFixptOff%         := 99;
const stateWaitForAllOff%           := 100;


var iState%:=stateVSGWait%;		'present state
var tStateStart:=-1;	        'Time that present state started. Used to measure wait time, fixation time, etc. 
var nextState%;                 'For WaitForBlankTo(), allows waiting for blank then moving to next state 
var stateBegin% := 1;           'Keep track of whether it is the first time through a state, for logging purposes

'Sampling Variables
var laNWavemarks% := 0;
var laNContinuous% := 0;
var laWavemarkPorts%[63];
var laContinuousPorts%[64];


' Window handles and channel numbers
var XChannel%,YChannel%;		' Channel number assigned to eye x and y
var PupilChannel%;
var XChannelPurkinje%,YChannelPurkinje%;		' Channel number assigned to eye x and y, Purkinje
var PupilChannelPurkinje%;
'var XChannelDuplicate%, YChannelDuplicate%;   'Channel number assigned to duplicate eye x and y, used for velocity estimation
'var EyeVelocityChannel%;    '**Virtual** channel that will calculate eye velocity in deg/second
var FixPointChannel%;
var StimChannel%;
var AdvanceChannel%;
var ReadyChannel%;			' channel number for VSG ready pulse signal
var TimingChannel%;
var UtilityChannel%;
var PageToggleChannel%;
var OptoCopyChannel%;
var DataWindow%;	' time view
var XYWindow%;		' window with eye pos shown -- this is for eye pos and fixpt only
var iLoc1aChannel%;	' channel number for Loc1 in xy window (let's not bother showing a point, the response window is good enough
var iLoc1bChannel%;	' channel number for Loc1 in xy window
var iLoc2aChannel%;	' channel number for Loc2 in xy window
var iLoc2bChannel%;	' channel number for Loc2 in xy window
var iFixChannel%;	' channel number for fixpt in xy window
var iFixWindowChannel%;' channel number for fixpt window in xy window
var iMonitorChannel%;	' channel number for monitor position display in xy window
'var iEyePosChannel% := 1;   ' channel 1 is always used as eye position channel in xy windows
var StimHandle%;	' handle for stimulus application


' Display stuff
var FixWindowX[36],FixWindowY[36];	' points for displaying fixation window in xy view, for now we only have one window size, so we only need to make one window
var Loc1aWindowX[36],Loc1aWindowY[36];  'points for displaying the four possible response windows
var Loc1bWindowX[36],Loc1bWindowY[36];
var Loc2aWindowX[36],Loc2aWindowY[36];
var Loc2bWindowX[36],Loc2bWindowY[36];
var windowX[36], windowY[36];



''''''''''  Preliminaries ''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
LogInit(1);

UseTwo1401s% := DoWeUseTwo1401s%();
GetPortsAndNumWMsWFs%(laNWavemarks%,laNContinuous%,laWavemarkPorts%[],laContinuousPorts%[]);

' Assign channel numbers for eye X,Y and trigger. 
XChannel% := 21;
YChannel% := 22;
PupilChannel% := 23;
ReadyChannel% := 24;
FixPointChannel% := 25;
StimChannel% := 26;
AdvanceChannel% := 27;
UtilityChannel% := 28;
TimingChannel% := 29;
PageToggleChannel% := 33;

XChannelPurkinje% := 34;
YChannelPurkinje% := 35;
PupilChannelPurkinje% := 36;
OptoCopyChannel% := 37;

ExcludedChans%[0] := 21;  'XChannel is lowest non-electrode channel used by this function
ExcludedChans%[1] := 37;  'Pupil channel (Purkinje) is highest non-electrode channel used by this function

' Assign color values - not sure if we want to show any traces, could be a late add if desired
'laEyeTraceColors%[0] := 8;
'laEyeTraceColors%[1] := 16;
'laEyeTraceColors%[2] := 24;
'laEyeTraceColors%[3] := 32;
'laEyeTraceColors%[4] := 10;
'laEyeTraceColors%[5] := 12;
'laEyeTraceColors%[6] := 14;
'laEyeTraceColors%[7] := 20;
'laEyeTraceColors%[8] := 22;
'laEyeTraceColors%[9] := 26;
'laEyeTraceColors%[10] := 27;
'laEyeTraceColors%[11] := 39;



''''''''''  START Code Execution ''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''

' Run dialog
if LookAwayScriptDialog%() = 0 then
    halt;  'Get out if dialog cancelled
endif

' Check if always looking flag is set. If so, issue a warning. 
if laAlwaysLooking% = 1 then
    if Query("Always looking is SET. Unset?") = 1 then
        laAlwaysLooking% := 0;
    endif
endif

if UseTwo1401s% = 0 then
    CreateSampleConfiguration();
    
    ' Get display windows ready
    InitializeWindows();
    
    tic := View(DataWindow%).BinSize(AdvanceChannel%);
    
    ' Prepare the toolbar buttons
    InitializeToolbar();
else
    InitializeToolbar();
endif;



''''''''''  END Code Execution ''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''


'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
'
' LookAway script END
'
'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''




'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
'
' LookAway script FUNCTIONS
'
'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''

'''''CreateSampleConfiguration'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''

proc CreateSampleConfiguration()
    var key$;
    var primaryTxt$;
    var secondaryTxt$;
    'var velo$;  'Used to define virtual eye velocity channel, this is currently not needed, implementation should be checked thoroughly
    
    key$:="AlertRig\\" + GetCurrentConfiguration$() + "\\Temp\\Filepref";
    SetPrimarySecondaryTxt(primaryTxt$,secondaryTxt$);
	SampleClear(); 'Set standard sampling state
    SampleChannels(64);  '32 does not work, we need more!
	SampleAutoComment(0); 'Do not prompt for comment after sampling
	SampleAutoCommit(60); 'Seconds between each file commit
    
	' Set path for new data files
	FilePathSet(dataPathRoot$ + "\\" + dataDataSet$, 3, 1);
	FilePathSet(dataPathRoot$ + "\\" + dataDataSet$, 1, 1);
	DoSampleAutoName(key$,"lookaway","la",primaryTxt$,secondaryTxt$);
	SampleAutoFile(1);  'Enable automatic file naming
    
    ' Text marks make extraction easier
    SampleTextMark(200);  '200 is max possible sampletext length
    
	'----Event Channel recording definitions----
    ' channel to look for ready signal from vsg
	SampleEvent(ReadyChannel%, 1, 2, 3600); 'Trigger channel, level
	SampleComment$(ReadyChannel%,"Ready");
	SampleTitle$(ReadyChannel%,"Ready");
    
	SampleEvent(FixPointChannel%, 2, 2, 3600);
	SampleComment$(FixPointChannel%, "FixPt");
	SampleTitle$(FixPointChannel%, "FixPt");
    
	SampleEvent(StimChannel%, 3, 2, 3600);
	SampleComment$(StimChannel%, "Stim");
	SampleTitle$(StimChannel%, "Stim");
    
	SampleEvent(AdvanceChannel%, 4, 2, 3600); 'Trigger channel, level
	SampleComment$(AdvanceChannel%, "Advance");
	SampleTitle$(AdvanceChannel%, "Advance");
    
    SampleEvent(PageToggleChannel%, 5, 2, 3600); 'Trigger channel, level
	SampleComment$(PageToggleChannel%, "Toggle");
	SampleTitle$(PageToggleChannel%, "Toggle");
    
    
    'Digmark channel for eyetracker timing pulses
    if RecordEyeTrackerOutputFile% = 1 then
        SampleDigMark(20);  '20 Hz should be plenty high for an expected sustained rate
        SampleTitle$(32,"EyeFilePulse");  'Digital marker is by definition channel 32
    endif
    
       
    
    '----Analog, non-spiking electrode recording conditions
    'EYE CHANNELS. Last # is sampling freq in Hz. 
    if EyeXPort% > -1 then  'don't set up eye channels unless we are looking at eye position
        ' Set up eye X channel
        SampleWaveform(XChannel%,GetEyeXPort%(),1000);
        SampleTitle$(XChannel%,EyeXPortLabel$);
    endif;
    
    if EyeYPort% > -1 then  'don't set up eye channels unless we are looking at eye position
        ' Set up eye Y channel 
        SampleWaveform(YChannel%,GetEyeYPort%(),1000);
        SampleTitle$(YChannel%,EyeYPortLabel$);
    endif;
    
    if PupilPort% > -1 then
        SampleWaveform(PupilChannel%,PupilPort%,1000);       
        SampleTitle$(PupilChannel%,PupilPortLabel$);
    endif;
    
    if EyeXPortPurkinje% > -1 then  'don't set up eye channels unless we are looking at eye position
        ' Set up eye X channel
        SampleWaveform(XChannelPurkinje%,GetEyeXPortPurkinje%(),1000);
        SampleTitle$(XChannelPurkinje%,EyeXPortLabelPurkinje$);
    endif;
    
    if EyeYPortPurkinje% > -1 then  'don't set up eye channels unless we are looking at eye position
        ' Set up eye Y channel 
        SampleWaveform(YChannelPurkinje%,GetEyeYPortPurkinje%(),1000);
        SampleTitle$(YChannelPurkinje%,EyeYPortLabelPurkinje$);
    endif;
    
    if PupilPortPurkinje% > -1 then
        SampleWaveform(PupilChannelPurkinje%,PupilPortPurkinje%,1000);       
        SampleTitle$(PupilChannelPurkinje%,PupilPortLabelPurkinje$);
    endif;
    
    if laDoOpto% = 1 and OptoEffCopyPort% > -1 then
        SampleWaveform(OptoCopyChannel%,OptoEffCopyPort%,5000); 
        SampleTitle$(OptoCopyChannel%,OptoPortLabel$);
    endif;
    
    if UtilityPort% > -1 then
        SampleWaveform(UtilityChannel%,UtilityPort%,30000);         
        SampleTitle$(UtilityChannel%,UtilityPortLabel$);
    endif;
    
    if UseTwo1401s% = 1 then
        SampleDigMark(20);  '20 Hz should be plenty high for an expected sustained rate
        SampleTitle$(32,"Timing");  'Digital marker is by definition channel 32
        
        SampleEvent(TimingChannel%, 6, 2, 3600); 'Trigger channel, level
        SampleComment$(TimingChannel%,"Handshake");
        SampleTitle$(TimingChannel%,"Hndshk");
    endif
    
    
    '----Duplicate eye channels to create eye velocity channel----
    'With the new conception of this experiment tracking eye velocity
    'is no longer necessary (and was never actually ready) but this 
    'framework should work if we ever need to implement it
    
    '    'Create eye velocity channels
    '    docase
    '    case UseASLEyetracker% + UsePurkinjeEyetracker% = 0 then  'if no eye channels
    '        'Do nothing, no eye channels
    '    case UseASLEyetracker% > UsePurkinjeEyetracker% then  'if we are weighting ASL > Purkinje, use ASL
    '        XChannelDuplicate% := chanDuplicate(XChannel%);
    '        YChannelDuplicate% := chanDuplicate(YChannel%);
    '    else  'if we are weighting Purkinje >= ASL, use Purkinje
    '        XChannelDuplicate% := chanDuplicate(XChannelPurkinje%);
    '        YChannelDuplicate% := chanDuplicate(YChannelPurkinje%);
    '    endcase
    
    '    'Add slope and smoothing to channels (if they exist) to get velocity estimate
    '    if UseASLEyetracker% + UsePurkinjeEyetracker% > 0 then
    '        ChanProcessAdd(XChannelDuplicate%,3);  'Add slope to duplicate X channel, use default width of 3x sample interval
    '        ChanProcessAdd(YChannelDuplicate%,3);  'Add slope to duplicate Y channel, use default width of 3x sample interval
    '        ChanProcessAdd(XChannelDuplicate%,1);  'Add smoothing to duplicate X channel, use default width of 10x sample interval
    '        ChanProcessAdd(YChannelDuplicate%,1);  'Add smoothing to duplicate Y channel, use default width of 10x sample interval
    '    endif
    
    '    'Update duplicate channel title and units - if channel does not exist, nothing happens, NBD
    '    ChanTitle$(XChannelDuplicate%,"EyeXVelo");
    '    ChanTitle$(YChannelDuplicate%,"EyeYVelo");
    '    ChanUnits$(XChannelDuplicate%,"Volts/s");
    '    ChanUnits$(YChannelDuplicate%,"Volts/s");
    
    '    'Create and set up virtual channel for eye velocity
    '    'velo$ := "Sqrt(Sqr(Ch(21a))+Sqr(Ch(22a)))*2.5";  'There are four questions to resolve here:
    '    '                                                  1) What is the channel number of a duplicate channel?  It can't be "21a" as on screen, because this is an INT.
    '    '                                                  2) How to build string expression using the value in XChannelDuplicate%
    '    '                                                  3) How to build string expression with value of deg2volt variable
    '    '                                                  4) Can value in virtual channel be read by CHAN in the output sequencer?
    '    EyeVelocityChannel% := VirtualChan(0,velo$,XChannelDuplicate%);
    
    
    
    '    'Update ExcludedChans based on given channel numbers for duplicate channels
    '    'Note that at the point of coding it is entirely unclear what channel numbers
    '    'will be used here but it appears that they will be automatically assigned so
    '    'we kind of have to hope that something sensible is done channel-wise.  I kind 
    '    'of fear it's going to put them at the bottom (i.e. channels 1-X) and this will
    '    'screw up our excluded chans setup, putting the electrode channels way up past 
    '    '35 but there's not really a LOT to do right now about it.  If it's a problem
    '    'then I'll cross that bridge.
    '    if XChannelDuplicate% > 0 and XChannelDuplicate% < ExcludedChans%[0] then
    '        ExcludedChans%[0] := XChannelDuplicate%;
    '    endif
    '    if YChannelDuplicate% > 0 and YChannelDuplicate% < ExcludedChans%[0] then
    '        ExcludedChans%[0] := YChannelDuplicate%;
    '    endif
    '    if XChannelDuplicate% > ExcludedChans%[1] then
    '        ExcludedChans%[1] := XChannelDuplicate%;
    '    endif
    '    if YChannelDuplicate% > ExcludedChans%[1] then
    '        ExcludedChans%[1] := YChannelDuplicate%;
    '    endif
    '    'Deal with virtual channel as well???  No, virtual channel will not be treated as a regular channel. 
    
    
    '----Set up "spiking" Electrode Channels----
    SetUpElectrodeConfiguration(laNWavemarks%,ExcludedChans%[]);
    
    
	if UseTwo1401s% = 0 then
        SampleSequencer(script$ + "Tuning.pls");
    else
        SampleSequencer(script$ + "TuningSendTrigger.pls");
    endif;
    
	DoSampleOptimise();
	SampleMode(1); 'Continuous sampling
    
    
end;



'''''InitializeWindows'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''

proc InitializeWindows()
    
	'Open the data sampling window
	DataWindow% := FileNew(0,4);
	Window(0, 50, 100, 100);
    XRange(0, 30);
	View(DataWindow%).WindowVisible(1);
    
	'Open an XY view to display the star-shape of the persistent eye trace
    'This particular display is probably not too useful for the LookAway task
    'so we will comment it out for now  TODO but think about it
    '	StarWindow% := FileNew(12);
    '	XRange(-15,15);
    '	YRange(-2,-15,15);  'set Y range for all visible channels
    '	XYDrawMode(0,5,0);  'do not autoscale
    '	WindowVisible(1);
    '	Window(50, 0, 100, 50);
    '	XYColour(1,16);
    
	' Channel 1 is eye pos. Set size of this channel's data to 0 - expands as needed. Join points, too. 
    '	XYSize(1, 0);
    '	XYJoin(1, 1);
    '	XYDrawMode(1, 2, 1);	' dot size is 1
    
    
	'Open an XY view to display eye position
	XYWindow% := FileNew(12);
    iEyePosChannel% := 1;  'The primary eye position channel is #1 - this is the eye position as determined based on whatever arbitrary combination of ASL and Purkinje data
	XRange(-15,15);
	YRange(-2,-15,15);  'set Y range for all visible channels
	XYDrawMode(0,5,0);  'do not autoscale
	WindowVisible(1);
	Window(0, 0, 50, 50);
	XYColour(iEyePosChannel%,16);  'Make this channel red
	XYSize(iEyePosChannel%,-1);  'Only one point on this channel
    
    
    'Create a new channel in the XY view to show the ASL eye position
    iEyePosASLChannel% := XYSetChan(0);
    XYColour(iEyePosASLChannel%,8);  'Make this channel dark green
	XYSize(iEyePosASLChannel%,-1);  'Only one point on this channel
    
    'Create a new channel in the XY view to show the Purkinje eye position
    iEyePosPurkinjeChannel% := XYSetChan(0);
    XYColour(iEyePosPurkinjeChannel%,32);  'Make this channel purplekinje
	XYSize(iEyePosPurkinjeChannel%,-1);  'Only one point on this channel;
    
    
	'Calcuate the fixation window
	var index%;
	var twopi;
	twopi := 2.0*4.0*ATan(1.0);
	
	for index% := 0 to 35 do
		FixWindowX[index%] := WindowRadius * Cos(index% * twopi/36.0);
		FixWindowY[index%] := WindowRadius * Sin(index% * twopi/36.0);
	next;
    
    'Draw response window for all possible response locations
    ArrConst(Loc1aWindowX[], FixWindowX[]);
	ArrAdd(Loc1aWindowX[], laLoc1aXDeg);  'Note that we initially assigned this value (&Y) in the dialog.  Start function will re-grab, but it will be the same.
	ArrConst(Loc1aWindowY[], FixWindowY[]);
	ArrAdd(Loc1aWindowY[], laLoc1aYDeg);
    
    ArrConst(Loc1bWindowX[], FixWindowX[]);
	ArrAdd(Loc1bWindowX[], laLoc1bXDeg);
	ArrConst(Loc1bWindowY[], FixWindowY[]);
	ArrAdd(Loc1bWindowY[], laLoc1bYDeg);
    
    ArrConst(Loc2aWindowX[], FixWindowX[]);
	ArrAdd(Loc2aWindowX[], laLoc2aXDeg);
	ArrConst(Loc2aWindowY[], FixWindowY[]);
	ArrAdd(Loc2aWindowY[], laLoc2aYDeg);
    
    ArrConst(Loc2bWindowX[], FixWindowX[]);
	ArrAdd(Loc2bWindowX[], laLoc2bXDeg);
	ArrConst(Loc2bWindowY[], FixWindowY[]);
	ArrAdd(Loc2bWindowY[], laLoc2bYDeg);
    
    
	'Create a new channel in the XY view to display the fixation window
	iFixWindowChannel% := XYSetChan(0);
	XYColour(iFixWindowChannel%, 13);  'Window is blue
	XYDrawMode(iFixWindowChannel%, 2, 1);
	XYJoin(iFixWindowChannel%, 1);
    
	'Create a new channel in the XY view to display the fixation point
	iFixChannel% := XYSetChan(0);
    XYColour(iFixChannel%, 13);  'Fixpt is blue
    
	'Create a new channel in the XY view to display the target window at location 1a
	iLoc1aChannel% := XYSetChan(0);
	XYColour(iLoc1aChannel%, 13);  'default as blue, will update to red (16) later if target
	XYDrawMode(iLoc1aChannel%, 2, 1);
	XYJoin(iLoc1aChannel%, 1);
    
    'Create a new channel in the XY view to display the target window at location 1b
	iLoc1bChannel% := XYSetChan(0);
	XYColour(iLoc1bChannel%, 13);  'default as blue, will update to red (16) later if target
	XYDrawMode(iLoc1bChannel%, 2, 1);
	XYJoin(iLoc1bChannel%, 1);
    
    'Create a new channel in the XY view to display the target window at location 2a
	iLoc2aChannel% := XYSetChan(0);
	XYColour(iLoc2aChannel%, 13);  'default as blue, will update to red (16) later if target
	XYDrawMode(iLoc2aChannel%, 2, 1);
	XYJoin(iLoc2aChannel%, 1);
    
    'Create a new channel in the XY view to display the target window at location 2b
	iLoc2bChannel% := XYSetChan(0);
	XYColour(iLoc2bChannel%, 13);  'default as blue, will update to red (16) later if target
	XYDrawMode(iLoc2bChannel%, 2, 1);
	XYJoin(iLoc2bChannel%, 1);
    
	'Create a new channel in the XY view to show the monitor's location
	iMonitorChannel% := XYSetChan(0);
	XYColour(iMonitorChannel%, 13);  'monitor location is blue
	XYDrawMode(iMonitorChannel%, 3, 1);
	XYJoin(iMonitorChannel%, 2);
	XYAddData(iMonitorChannel%, -9, -7);
	XYAddData(iMonitorChannel%, 9, -7);
	XYAddData(iMonitorChannel%, 9, 7);
	XYAddData(iMonitorChannel%, -9, 7);
    
end;


'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
'
' InitializeToolbar - prepare toolbar buttons. Note that the idle processing function (ToolbarSet(0, blah, blah)) is 
' not set here. That's done when the user hits the start button.
'
proc InitializeToolbar()
    
	View(App(8)).WindowVisible(0);	'Hide the standard sample bar
	ToolbarVisible(1);
    if UseTwo1401s% = 1 then
        ToolbarSet(1,"StartPlexon",StartPlexon%);
    else
        ToolbarSet(1,"Sample start",Start%);
    endif;
	ToolbarSet(2,"Sample stop", Stop%);
	ToolbarSet(3,"Juice", DefaultReward%);
	ToolbarSet(4,"Quit", Quit%);
	ToolbarEnable(2,0);
	Toolbar("Go", 0x3ff);
    
end;



''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
func Start%()
    
    
	var CommandLine$;
    var Opener$;
    var RemoteArg$;
    var ProgName$;
	var TargetArg$;
    var Verbose$;
    var TriggerPort$;
    var BGColor$;
    var Dist2Screen$;
    var FixationArg$;
    var MultSacc$;
    var MultSaccFilename$;
    var MultSaccHandle%;
    var fpx, fpy, fpd, fpr;     ' fixpt parameters
    var startSecs := 5;
    var pulseFound%;
    var tRise;
    var tFall;
    var gr$;  'to grab the grating parameters for parsing
    var ow, oh, iw, ih, sf, tf, phse, ctf;
    var con%;
    var cv$, pat$, ap$;
    var i%;  'For looping through JAWS/no-JAWS trials, also used as generic looping variable
    var j%;  'For looping through to-JF/away-JF trials
    var k%;  'For looping through one-saccade/two-saccade trials, or microstim/no-microstim trials
    var m%;  'For looping through S2-targ-a/S2-targ-b
    var m2%; 'Needed for counterbalance in single-saccade task
    var n%;  'For looping through nRepeats
    var s;
    var colonOrNot$;
    'Variables to encode the possible gratings
    var g1a$;    'Grating 1a - the JAWS field grating
    var g1b$;    'Grating 1b - the non-JAWS field S1 grating
    var g2a$;    'Grating 2a - the first S2 grating
    var g2b$;    'Grating 2b - the second S2 grating 
    var g1af$;   'Faded version of grating 1a
    var g1bf$;   'Faded version of grating 1b
    var g1ao$;   'Orthogonal version of grating 1a
    var g1bo$;   'Orthogonal version of grating 1b
    var g1afo$;  'Faded, orthogonal version of grating 1a
    var g1bfo$;  'Faded, orthogonal version of grating 1b
    var g2af$;   'Faded version of grating 2a
    var g2bf$;   'Faded version of grating 2b
    var g2ao$;   'Orthogonal version of grating 2a 
    var g2bo$;   'Orthogonal version of grating 2b
    var g2afo$;  'Faded, orthogonal version of grating 2a
    var g2bfo$;  'Faded, orthogonal version of grating 2b
    var orthOri;
    var loc1ap%;                                  'Is this stimulus present?
    var loc1bp%;
    var loc2ap%;
    var loc2bp%;
    var loc1af%;                                  'Is this stimulus faded?
    var loc1bf%;
    var loc2af%;
    var loc2bf%;
    var loc1ao%;                                  'Is this stimulus orthogonal to the preferred orientation?
    var loc1bo%;
    var loc2ao%;
    var loc2bo%;
    var JAWS%[laMaxTrialPerDataPoint%*2];
    var nJ%;
    var JF%[laMaxTrialPerDataPoint%*2];
    var nJF%;
    var Sacc%[laMaxTrialPerDataPoint%*2];
    var nS%;
    var tempTarg%;  'temporary target indicator, used to allow easy randomization of S2 saccade location in two-S2 double saccade task without forcing a true counterbalance
    var numGratings%;
    
    'We do not currently use the fixpt parameter values
    'GetFixationPointParameterValues(fpx, fpy, fpd, fpr);  'It may be useful to know where the fixpt is for setting up locations 1 and 2
    
    'Set idle loop control variables based on experiment type
    StartSetExptVariables(laExperimentType%,laTrainingStageSSGNG%,laTrainingStageSSMicro%,laTrainingStageDS2S1%,laTrainingStageDS2S2%);
    
    'Create multi-saccade filename
    MultSaccFilename$ := GetScriptDir$(0)+"..\\..\\multi-sacc.txt";  'This is a text file which holds trial definitions for the multisaccade experiment
    Printlog("Writing Multi-Page command file to %s\n",MultSaccFilename$);

    'Get values for grating properties from the main stimulus
    gr$ := GetGratingParameters$("Stimulus");
    ParseGratingParameters%(gr$, laLoc1aXDeg, laLoc1aYDeg, ow, oh, iw, ih, con%, sf, tf, laGratingOri, phse, cv$, pat$, ap$, ctf);
    
    'Here is the panoply of variables we will be using to fill out and build the .txt file
    'nTrials% := CalcNumTrials%(laNRepeats%,laNRepeatsUseJAWS%,laNRepeatsNoJAWS%,laNRepeatsLoc1ToJF%,
    '            laNRepeatsLoc1AwayJF%,laNRepeatsLoc1Only%,laNRepeatsLoc1Loc2%,laExperimentType%,laTrainingStageSSGNG%,
    '            laTrainingStageSSMicro%,laTrainingStageDS2S1%,laTrainingStageDS2S2%);
    'var laTarget1Loc%[MAXTRIALS%];                'Trial-by-trial location of saccade target 1; can be 0 (no target, no-go), 1 (target is Loc1a), or 2 (target is Loc1b)
    'var laTarget2Loc%[MAXTRIALS%];                'Trial-by-trial location of saccade target 2; can be 0 (no saccade 2), 10 (target is Loc2a), or 11 (target is Loc2b)...jumping to 10/11 gives opportunity to draw more stimuli in the S1 period, just in case
    'var laLocsPresent%[MAXTRIALS%];               'Trial-by-trial indication of locations present, overall.  Is the sum of 1 (Loc1a present), 2 (Loc1b present), 4 (Loc2a present) and 8 (Loc2b present)
    'var laPage1Draw%[MAXTRIALS%];                 'Trial-by-trial indication of locations present on Page 1, for drawing in fixation display window, built in same way as laLocsPresent
    'var laPage2Draw%[MAXTRIALS%];                 'Same, for Page 2
    'var laPage3Draw%[MAXTRIALS%];                 'Same, for Page 3
    'var laPage1Fade%[MAXTRIALS%];                 'Trial-by-trial indication of locations present on Page 1, for drawing in fixation display window, built in same way as laLocsPresent
    'var laPage2Fade%[MAXTRIALS%];                 'Same, for Page 2
    'var laPage3Fade%[MAXTRIALS%];                 'Same, for Page 3
    'var laOptoThisTrial%[MAXTRIALS%];             'Trial-by-trial control of whether opto is used
    'var laMicroThisTrial%[MAXTRIALS%];            'Trial-by-trial control of whether microstim is used

    'Encode the grating spec for all possible stimuli, whether they might be used or not, easy enough to bang out.
    g1a$ := EncodeGratingParameters$(laLoc1aXDeg, laLoc1aYDeg, ow, oh, iw, ih, con%, sf, tf, laGratingOri, phse, cv$, pat$, ap$, ctf);
    g1b$ := EncodeGratingParameters$(laLoc1bXDeg, laLoc1bYDeg, ow, oh, iw, ih, con%, sf, tf, laGratingOri, phse, cv$, pat$, ap$, ctf);
    g2a$ := EncodeGratingParameters$(laLoc2aXDeg, laLoc2aYDeg, ow, oh, iw, ih, con%, sf, tf, laGratingOri, phse, cv$, pat$, ap$, ctf);
    g2b$ := EncodeGratingParameters$(laLoc2bXDeg, laLoc2bYDeg, ow, oh, iw, ih, con%, sf, tf, laGratingOri, phse, cv$, pat$, ap$, ctf);
    g1af$ := EncodeGratingParameters$(laLoc1aXDeg, laLoc1aYDeg, ow, oh, iw, ih, laContrastFade%, sf, tf, laGratingOri, phse, cv$, pat$, ap$, ctf);
    g1bf$ := EncodeGratingParameters$(laLoc1bXDeg, laLoc1bYDeg, ow, oh, iw, ih, laContrastFade%, sf, tf, laGratingOri, phse, cv$, pat$, ap$, ctf);
    g2af$ := EncodeGratingParameters$(laLoc2aXDeg, laLoc2aYDeg, ow, oh, iw, ih, laContrastFade%, sf, tf, laGratingOri, phse, cv$, pat$, ap$, ctf);
    g2bf$ := EncodeGratingParameters$(laLoc2bXDeg, laLoc2bYDeg, ow, oh, iw, ih, laContrastFade%, sf, tf, laGratingOri, phse, cv$, pat$, ap$, ctf);
    orthOri := laGratingOri + 90;
    if orthOri >= 360 then
        orthOri := orthOri - 360;  'honestly the VSG probably handles orientations > 360, but why risk it?
    endif;
    g1ao$ := EncodeGratingParameters$(laLoc1aXDeg, laLoc1aYDeg, ow, oh, iw, ih, con%, sf, tf, orthOri, phse, cv$, pat$, ap$, ctf);
    g1bo$ := EncodeGratingParameters$(laLoc1bXDeg, laLoc1bYDeg, ow, oh, iw, ih, con%, sf, tf, orthOri, phse, cv$, pat$, ap$, ctf);
    g1afo$ := EncodeGratingParameters$(laLoc1aXDeg, laLoc1aYDeg, ow, oh, iw, ih, laContrastFade%, sf, tf, orthOri, phse, cv$, pat$, ap$, ctf);
    g1bfo$ := EncodeGratingParameters$(laLoc1bXDeg, laLoc1bYDeg, ow, oh, iw, ih, laContrastFade%, sf, tf, orthOri, phse, cv$, pat$, ap$, ctf);
    if laExperimentType% = 0 then
        'Note that these are S2s but they are in the S1 locations for orthogonal/orthogonal-fade for the GNG experiment
        g2ao$ := EncodeGratingParameters$(laLoc1aXDeg, laLoc1aYDeg, ow, oh, iw, ih, con%, sf, tf, orthOri, phse, cv$, pat$, ap$, ctf);
        g2bo$ := EncodeGratingParameters$(laLoc1bXDeg, laLoc1bYDeg, ow, oh, iw, ih, con%, sf, tf, orthOri, phse, cv$, pat$, ap$, ctf);
        g2afo$ := EncodeGratingParameters$(laLoc1aXDeg, laLoc1aYDeg, ow, oh, iw, ih, laContrastFade%, sf, tf, orthOri, phse, cv$, pat$, ap$, ctf);
        g2bfo$ := EncodeGratingParameters$(laLoc1bXDeg, laLoc1bYDeg, ow, oh, iw, ih, laContrastFade%, sf, tf, orthOri, phse, cv$, pat$, ap$, ctf);
    else
        g2ao$ := EncodeGratingParameters$(laLoc2aXDeg, laLoc2aYDeg, ow, oh, iw, ih, con%, sf, tf, orthOri, phse, cv$, pat$, ap$, ctf);
        g2bo$ := EncodeGratingParameters$(laLoc2bXDeg, laLoc2bYDeg, ow, oh, iw, ih, con%, sf, tf, orthOri, phse, cv$, pat$, ap$, ctf);
        g2afo$ := EncodeGratingParameters$(laLoc2aXDeg, laLoc2aYDeg, ow, oh, iw, ih, laContrastFade%, sf, tf, orthOri, phse, cv$, pat$, ap$, ctf);
        g2bfo$ := EncodeGratingParameters$(laLoc2bXDeg, laLoc2bYDeg, ow, oh, iw, ih, laContrastFade%, sf, tf, orthOri, phse, cv$, pat$, ap$, ctf);
    endif
    
    'Build guide variables which will tell us how many instances of JAWS/no-Jaws, to-JF/away-JF, and 1-Sacc/2-Sacc (alternately micro/no-micro) to use
    nJ% := laNRepeatsUseJAWS% + laNRepeatsNoJAWS%;
    for i% := 0 to laNRepeatsUseJAWS%-1 do
        JAWS%[i%] := 1;  'JAWS%[] will be 1 if using opto, 0 if not
    next
    nJF% := laNRepeatsLoc1ToJF% + laNRepeatsLoc1AwayJF%;
    for i% := 0 to laNRepeatsLoc1AwayJF%-1 do
        JF%[i%] := 1;  'JF%[] will be 0 if primary location is JF (loc1a), 1 if not (loc1b) - this may seem backwards but makes things easier in the huge DOCASE below
    next
    nS% := laNRepeatsLoc1Only% + laNRepeatsLoc1Loc2%;
    for i% := 0 to laNRepeatsLoc1Only%-1 do
        Sacc%[i%] := 1;  'Sacc%[] will be 1 if one saccade only (or microstim), 0 if two saccade (or no microstim).  That's a bit weird but I think we can figure it out.
    next

    'Build out the values we need - it's only 970 lines of code, not even 1000!
    tc% := 0;
    docase
    case laExperimentType% = 0 then
        docase
        case laTrainingStageSSGNG% = 0 then
            for j% := 0 to nJF%-1 do
                for m% := 0 to 1 do  'S1 stimulus orientation, S2 is always opposite S1
                    for n% := 0 to laNRepeats%-1 do
                        laTarget1Loc%[tc%] := JF%[j%]+1;  'Target location is same as stimulus location, 1 or 2
                        laLocsPresent%[tc%] := JF%[j%]+1;  'Only location present is stimulus location, 1 or 2
                        laPage1Draw%[tc%] := JF%[j%]+1;  'Only location present on page 1 is stimulus location, 1 or 2
                        laPage2Draw%[tc%] := JF%[j%]+1;  'Only location present on page 2 is stimulus location, 1 or 2
                        if m% = 0 then  'say "0" = Ortho and "1" = Iso
                            laPage1Ortho%[tc%] := JF%[j%]+1;  'S1 is orthogonal (S2 will be iso)
                        else
                            laPage2Ortho%[tc%] := JF%[j%]+1;  'S2 is orthogonal (S1 will be iso)
                        endif
                        laPage1Fade%[tc%] := JF%[j%]+1;  'Fade on page one at target location
                        
                        if JF%[j%] = 0 then  'For Loc1a
                            if m% = 0 then  'S1 is ortho, S2 is not
                                laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Ortho; ";
                                laInitialST$[tc%] += "S2 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + "; ";
                            else 'S2 is ortho, S1 is not
                                laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + "; ";
                                laInitialST$[tc%] += "S2 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Ortho; ";
                            endif
                        else 'for Loc1b
                            if m% = 0 then  'S1 is ortho, S2 is not
                                laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Ortho; ";
                                laInitialST$[tc%] += "S2 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + "; ";
                            else 'S2 is ortho, S1 is not
                                laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + "; ";
                                laInitialST$[tc%] += "S2 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Ortho; ";
                            endif
                        endif
                        
                        tc% += 1;  'Increment index
                    next
                next
            next
        case laTrainingStageSSGNG% = 1 then
            for j% := 0 to nJF%-1 do  'S1/S2 location
                for m% := 0 to 1 do  'is S1 0rtho or 1so
                    for m2% := 0 to 1 do  'is S2 0rtho or 1so - if m2% = m% then we expect NO-GO
                        for n% := 0 to laNRepeats%-1 do
                            if m2% = m% then
                                laTarget1Loc%[tc%] := 0;  'The "target" loction did not change, this is a NO-GO trial
                            else
                                laTarget1Loc%[tc%] := JF%[j%]+1;  'Target location is same as stimulus location, 1 or 2
                            endif
                            laLocsPresent%[tc%] := JF%[j%]+1;  'Only location present is stimulus location, 1 or 2
                            laPage1Draw%[tc%] := JF%[j%]+1;  'Only location present on page 1 is stimulus location, 1 or 2
                            laPage2Draw%[tc%] := JF%[j%]+1;  'Only location present on page 2 is stimulus location, 1 or 2
                            laPage1Ortho%[tc%] := (JF%[j%]+1)*(1-m%);  'S1 location is orthogonal if m% is zero
                            laPage2Ortho%[tc%] := (JF%[j%]+1)*(1-m2%);  'S2 location is orthogonal if m2% is zero
                            
                            if JF%[j%] = 0 then
                                if m% = 0 then
                                    if m2% = 0 then
                                        laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Ortho; ";
                                        laInitialST$[tc%] += "S2 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Ortho; ";
                                    else
                                        laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Ortho; ";
                                        laInitialST$[tc%] += "S2 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + "; ";
                                    endif
                                else
                                    if m2% = 0 then
                                        laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + "; ";
                                        laInitialST$[tc%] += "S2 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Ortho; ";
                                    else
                                        laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + "; ";
                                        laInitialST$[tc%] += "S2 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + "; ";
                                    endif
                                endif
                            else
                                if m% = 0 then
                                    if m2% = 0 then
                                        laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Ortho; ";
                                        laInitialST$[tc%] += "S2 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Ortho; ";
                                    else
                                        laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Ortho; ";
                                        laInitialST$[tc%] += "S2 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + "; ";
                                    endif
                                else
                                    if m2% = 0 then
                                        laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + "; ";
                                        laInitialST$[tc%] += "S2 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Ortho; ";
                                    else
                                        laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + "; ";
                                        laInitialST$[tc%] += "S2 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + "; ";
                                    endif
                                endif
                            endif
                            
                            tc% += 1;  'Increment index
                        next
                    next
                next
            next
        case laTrainingStageSSGNG% = 2 then
            for j% := 0 to nJF%-1 do  'S1/S2 location
                for m% := 0 to 1 do  'is S1 0rtho or 1so
                    for m2% := 0 to 1 do  'is S2 0rtho or 1so - if m2% = m% then we expect NO-GO
                        for n% := 0 to laNRepeats%-1 do
                            'This is identical to stage=1 except the S2 has moved to Page 3, Page 2 is a gap
                            if m2% = m% then
                                laTarget1Loc%[tc%] := 0;  'The "target" loction did not change, this is a NO-GO trial
                            else
                                laTarget1Loc%[tc%] := JF%[j%]+1;  'Target location is same as stimulus location, 1 or 2
                            endif
                            laLocsPresent%[tc%] := JF%[j%]+1;  'Only location present is stimulus location, 1 or 2
                            laPage1Draw%[tc%] := JF%[j%]+1;  'Only location present on page 1 is stimulus location, 1 or 2
                            laPage3Draw%[tc%] := JF%[j%]+1;  'Only location present on page 2 is stimulus location, 1 or 2
                            laPage1Ortho%[tc%] := (JF%[j%]+1)*(1-m%);  'S1 location is orthogonal if m% is zero
                            laPage3Ortho%[tc%] := (JF%[j%]+1)*(1-m2%);  'S2 location is orthogonal if m2% is zero
                            
                            if JF%[j%] = 0 then
                                if m% = 0 then
                                    if m2% = 0 then
                                        laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Ortho; ";
                                        laInitialST$[tc%] += "S2 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Ortho; ";
                                    else
                                        laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Ortho; ";
                                        laInitialST$[tc%] += "S2 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + "; ";
                                    endif
                                else
                                    if m2% = 0 then
                                        laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + "; ";
                                        laInitialST$[tc%] += "S2 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Ortho; ";
                                    else
                                        laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + "; ";
                                        laInitialST$[tc%] += "S2 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + "; ";
                                    endif
                                endif
                            else
                                if m% = 0 then
                                    if m2% = 0 then
                                        laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Ortho; ";
                                        laInitialST$[tc%] += "S2 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Ortho; ";
                                    else
                                        laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Ortho; ";
                                        laInitialST$[tc%] += "S2 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + "; ";
                                    endif
                                else
                                    if m2% = 0 then
                                        laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + "; ";
                                        laInitialST$[tc%] += "S2 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Ortho; ";
                                    else
                                        laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + "; ";
                                        laInitialST$[tc%] += "S2 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + "; ";
                                    endif
                                endif
                            endif
                            
                            tc% += 1;  'Increment index
                        next
                    next
                next
            next
        case laTrainingStageSSGNG% = 3 then
            for i% := 0 to nJ%-1 do
                for j% := 0 to nJF%-1 do  'Target location
                    for m% := 0 to 1 do  'is S1 location 0rtho or 1so
                        for m2% := 0 to 1 do  'is S2 in S1 location 0rtho or 1so - if m2% = m% then we expect NO-GO
                            for n% := 0 to laNRepeats%-1 do
                                'This is identical to stage=2 except we fade in the distractor stimulus on Page 3 and add opto
                                if m2% = m% then
                                    laTarget1Loc%[tc%] := 0;  'The "target" loction did not change, this is a NO-GO trial
                                else
                                    laTarget1Loc%[tc%] := JF%[j%]+1;  'Target location is same as stimulus location, 1 or 2
                                endif
                                laLocsPresent%[tc%] := 1+2;  'Both S1 locations present
                                laPage1Draw%[tc%] := JF%[j%]+1;  'Only location present on page 1 is stimulus location, 1 or 2
                                laPage3Draw%[tc%] := 1+2;  'Both S2 locations present on page 3
                                laPage1Ortho%[tc%] := (JF%[j%]+1)*(1-m%);  'S1 location is orthogonal if m% is zero
                                'When there are two locations for S2, exactly one must be orthogonal, either 1 or 2
                                if m2% = 0 then
                                    laPage3Ortho%[tc%] := JF%[j%]+1;  'same-loc is orthogonal
                                else
                                    laPage3Ortho%[tc%] := 2-JF%[j%];  'same-loc is iso, then opposite-loc is orthogonal
                                endif
                                laPage3Fade%[tc%] := 2-JF%[j%];  'Fade on page three is opposite of the draw location on page 1
                                laOptoThisTrial%[tc%] := JAWS%[i%];  'JAWS yes/no 1/0
                                
                                if JF%[j%] = 0 then
                                    if m% = 0 then
                                        if m2% = 0 then
                                            laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Ortho; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Ortho; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Fade; ";
                                        else
                                            laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Ortho; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + "; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Ortho, Fade; ";
                                        endif
                                    else
                                        if m2% = 0 then
                                            laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + "; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Ortho; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Fade; ";
                                        else
                                            laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + "; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + "; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Ortho, Fade; ";
                                        endif
                                    endif
                                else
                                    if m% = 0 then
                                        if m2% = 0 then
                                            laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Ortho; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Ortho; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Fade; ";
                                        else
                                            laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Ortho; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + "; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Ortho, Fade; ";
                                        endif
                                    else
                                        if m2% = 0 then
                                            laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + "; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Ortho; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Fade; ";
                                        else
                                            laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + "; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + "; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Ortho, Fade; ";
                                        endif
                                    endif
                                endif
                                
                                tc% += 1;  'Increment index
                            next
                        next
                    next
                next
            next
        case laTrainingStageSSGNG% = 4 then
            for i% := 0 to nJ%-1 do
                for j% := 0 to nJF%-1 do
                    for m% := 0 to 1 do  'is S1 location 0rtho or 1so
                        for m2% := 0 to 1 do  'is S2 in S1 location 0rtho or 1so - if m2% = m% then we expect NO-GO
                            for n% := 0 to laNRepeats%-1 do
                                'This is identical to stage=3 except the distractor stimulus on Page 3 is not faded
                                if m2% = m% then
                                    laTarget1Loc%[tc%] := 0;  'The "target" loction did not change, this is a NO-GO trial
                                else
                                    laTarget1Loc%[tc%] := JF%[j%]+1;  'Target location is same as stimulus location, 1 or 2
                                endif
                                laLocsPresent%[tc%] := 1+2;  'Both S1 locations present
                                laPage1Draw%[tc%] := JF%[j%]+1;  'Only location present on page 1 is stimulus location, 1 or 2
                                laPage3Draw%[tc%] := 1+2;  'Both S1 locations present on page 3
                                laPage1Ortho%[tc%] := (JF%[j%]+1)*(1-m%);  'S1 location is orthogonal if m% is zero
                                'When there are two locations for S2, exactly one must be orthogonal, either 1 or 2
                                if m2% = 0 then
                                    laPage3Ortho%[tc%] := JF%[j%]+1;  'same-loc is orthogonal
                                else
                                    laPage3Ortho%[tc%] := 2-JF%[j%];  'same-loc is iso, then opposite-loc is orthogonal
                                endif
                                laOptoThisTrial%[tc%] := JAWS%[i%];  'JAWS yes/no 1/0
                                
                                if JF%[j%] = 0 then
                                    if m% = 0 then
                                        if m2% = 0 then
                                            laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Ortho; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Ortho; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + "; ";
                                        else
                                            laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Ortho; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + "; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Ortho; ";
                                        endif
                                    else
                                        if m2% = 0 then
                                            laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + "; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Ortho; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + "; ";
                                        else
                                            laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + "; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + "; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Ortho; ";
                                        endif
                                    endif
                                else
                                    if m% = 0 then
                                        if m2% = 0 then
                                            laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Ortho; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Ortho; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + "; ";
                                        else
                                            laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Ortho; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + "; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Ortho; ";
                                        endif
                                    else
                                        if m2% = 0 then
                                            laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + "; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Ortho; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + "; ";
                                        else
                                            laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + "; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + "; ";
                                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Ortho; ";
                                        endif
                                    endif
                                endif
                                
                                tc% += 1;  'Increment index
                            next
                        next
                    next
                next
            next       
        endcase
    case laExperimentType% = 1 then
        docase
        case laTrainingStageSSMicro% = 0 then
            for j% := 0 to nJF%-1 do
                for n% := 0 to laNRepeats%-1 do
                    laTarget1Loc%[tc%] := (JF%[j%]+1)*2;  'Target location is same as stimulus location, 2 or 4 in microstim!
                    laLocsPresent%[tc%] := (JF%[j%]+1)*2;  'Only location present is stimulus location, 2 or 4 in microstim!
                    laPage1Draw%[tc%] := (JF%[j%]+1)*2;  'Only location present on page 1 is stimulus location, 2 or 4 in microstim!
                    
                    if JF%[j%] = 0 then
                        laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + "; ";
                    else
                        laInitialST$[tc%] := "S1 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + "; ";
                    endif
                    
                    tc% += 1;  'Increment index
                next
            next
        case laTrainingStageSSMicro% = 1 then
            for j% := 0 to nJF%-1 do
                for k% := 0 to nS%-1 do
                    for n% := 0 to laNRepeats%-1 do
                        laTarget1Loc%[tc%] := (JF%[j%]+1)*2;  'Target location is same as stimulus location, 2 or 4 in microstim!
                        laLocsPresent%[tc%] := (JF%[j%]+1)*2;  'Only location present is stimulus location, 2 or 4 in microstim!
                        laPage1Draw%[tc%] := (JF%[j%]+1)*2;  'Only location present on page 1 is stimulus location, 2 or 4 in microstim!
                        laPage2Draw%[tc%] := (JF%[j%]+1)*2;  'Only location present on page 1 is stimulus location, 2 or 4 in microstim, same as page 1
                        laMicroThisTrial%[tc%] := Sacc%[k%];  'Microstim yes/no 1/0
                        
                        if JF%[j%] = 0 then
                            laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + "; Microstim = " + Str$(Sacc%[k%]) + "; ";
                        else
                            laInitialST$[tc%] := "S1 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + "; Microstim = " + Str$(Sacc%[k%]) + "; ";
                        endif
                        
                        tc% += 1;  'Increment index
                    next
                next
            next
        case laTrainingStageSSMicro% = 2 then
            for i% := 0 to nJ%-1 do
                for j% := 0 to nJF%-1 do
                    for k% := 0 to nS%-1 do
                        for n% := 0 to laNRepeats%-1 do
                            laTarget1Loc%[tc%] := (JF%[j%]+1)*2;  'Target location is same as stimulus location, 2 or 4 in microstim!
                            laLocsPresent%[tc%] := (JF%[j%]+1)*2;  'Only location present is stimulus location, 2 or 4 in microstim!
                            laPage1Draw%[tc%] := (JF%[j%]+1)*2;  'Only location present on page 1 is stimulus location, 2 or 4 in microstim!
                            laPage2Draw%[tc%] := (JF%[j%]+1)*2;  'Only location present on page 1 is stimulus location, 2 or 4 in microstim, same as page 1
                            laPage2Fade%[tc%] := (JF%[j%]+1)*2;  'Always fade current location (only location on page, etc.)
                            laMicroThisTrial%[tc%] := Sacc%[k%];  'Microstim yes/no 1/0
                            laOptoThisTrial%[tc%] := JAWS%[i%];  'JAWS yes/no 1/0
                            
                            if JF%[j%] = 0 then
                                laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Fade out; ";
                            else
                                laInitialST$[tc%] := "S1 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + ", Fade out; ";
                            endif
                            'The Microstim/JAWS status is independent of whether the stimulus is in the JAWS field
                            laInitialST$[tc%] += "Microstim = " + Str$(Sacc%[k%]) + "; JAWS = " + Str$(JAWS%[i%]) + "; ";
                            
                            tc% += 1;  'Increment index
                        next
                    next
                next
            next
        case laTrainingStageSSMicro% = 3 then
            for i% := 0 to nJ%-1 do
                for j% := 0 to nJF%-1 do
                    for k% := 0 to nS%-1 do
                        for n% := 0 to laNRepeats%-1 do
                            laTarget1Loc%[tc%] := (JF%[j%]+1)*2;  'Target location is same as stimulus location, 2 or 4 in microstim!
                            laLocsPresent%[tc%] := (JF%[j%]+1)*2;  'Only location present is stimulus location, 2 or 4 in microstim!
                            laPage1Draw%[tc%] := (JF%[j%]+1)*2;  'Only location present on page 1 is stimulus location, 2 or 4 in microstim!
                            laMicroThisTrial%[tc%] := Sacc%[k%];  'Microstim yes/no 1/0
                            laOptoThisTrial%[tc%] := JAWS%[i%];  'JAWS yes/no 1/0
                            
                            if JF%[j%] = 0 then
                                laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Saccade to blank; ";
                            else
                                laInitialST$[tc%] := "S1 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + ", Saccade to blank; ";
                            endif
                            'The Microstim/JAWS status is independent of whether the stimulus is in the JAWS field
                            laInitialST$[tc%] += "Microstim = " + Str$(Sacc%[k%]) + "; JAWS = " + Str$(JAWS%[i%]) + "; ";
                            
                            tc% += 1;  'Increment index
                        next
                    next
                next
            next
        endcase
    case laExperimentType% = 2 then
        docase
        case laTrainingStageDS2S1% = 0 then
            for j% := 0 to nJF%-1 do
                for n% := 0 to laNRepeats%-1 do
                    laTarget1Loc%[tc%] := JF%[j%]+1;  'Target location is same as stimulus location, 1 or 2
                    laLocsPresent%[tc%] := JF%[j%]+1;  'Only location present is stimulus location, 1 or 2
                    laPage1Draw%[tc%] := JF%[j%]+1;  'Only location present on page 1 is stimulus location, 1 or 2

                    if JF%[j%] = 0 then
                        laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + "; ";
                    else
                        laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + "; ";
                    endif
                    
                    tc% += 1;  'Increment index
                next
            next
        case laTrainingStageDS2S1% = 1 then
            for j% := 0 to nJF%-1 do
                for k% := 0 to nS%-1 do
                    for n% := 0 to laNRepeats%-1 do
                        laTarget1Loc%[tc%] := JF%[j%]+1;  'Target location is same as stimulus location, 1 or 2
                        laPage1Draw%[tc%] := JF%[j%]+1;  'Only location present on page 1 is stimulus location, 1 or 2
                        if k% = 1 then  'k%=1 is one-saccade only
                            laLocsPresent%[tc%] := JF%[j%]+1;  'Only location present is S1 location, 1 or 2
                            laPage2Draw%[tc%] := 0;  'Nothing to draw on page 2
                            laPage3Draw%[tc%] := 0;  'Nothing to draw on page 3
                            laTarget2Loc%[tc%] := 0;  'No second target
                        else  'k%=0 is two-saccade
                            laLocsPresent%[tc%] := JF%[j%]+1+4;  'The stimulus location is present (1 or 2 = JF%[j%]+1) and loc2a is present (4)
                            laPage2Draw%[tc%] := JF%[j%]+1+4;  'same as locs present
                            laPage3Draw%[tc%] := 4;  'Page 3 is only the S2 in loc2a
                            laTarget2Loc%[tc%] := 4;  'Loc2a is always target
                        endif
                                                
                        if JF%[j%] = 0 then
                            laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + "; ";
                        else
                            laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + "; ";
                        endif
                        'The S2 location is the same regardless of whether the S1 is in the JAWS field or not
                        if k% = 0 then  
                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + "; ";
                        endif
                        
                        tc% += 1;  'Increment index
                    next
                next
            next
        case laTrainingStageDS2S1% = 2 then
            for j% := 0 to nJF%-1 do
                for n% := 0 to laNRepeats%-1 do
                    laTarget1Loc%[tc%] := JF%[j%]+1;  'Target location is same as stimulus location, 1 or 2
                    laTarget2Loc%[tc%] := 4;  'Target 2 is always loc2a
                    laLocsPresent%[tc%] := 1+2+4;  'Both S1s present on every trial
                    laPage1Draw%[tc%] := 1+2;  'Both S1s present on page 1
                    laPage1Fade%[tc%] := 2-JF%[j%];  'If target is position 1, fade stimulus 2; if in position 2 fade stimulus 1
                    laPage1Ortho%[tc%] := 2-JF%[j%];  'Fade-in location is orthogonal
                    laPage2Draw%[tc%] := 1+2+4;  'Both S1s present and S2 at loc2a on page 2
                    laPage2Fade%[tc%] := 2-JF%[j%];  'If target is position 1, fade stimulus 2; if in position 2 fade stimulus 1
                    laPage2Ortho%[tc%] := 2-JF%[j%];  'Fade-in location is orthogonal
                    laPage3Draw%[tc%] := 4;  'Loc2a present on page 3
                    
                    
                    if JF%[j%] = 0 then
                        laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Target; ";
                        laInitialST$[tc%] += "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Fade in, Dist, Ortho; ";
                    else
                        laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Target; ";
                        laInitialST$[tc%] += "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Fade in, Dist, Ortho; ";
                    endif
                    'The S2 location is the same regardless of whether the S1 is in the JAWS field or not
                    laInitialST$[tc%] += "S2 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + "; ";
                    
                    tc% += 1;  'Increment index
                next
            next
        case laTrainingStageDS2S1% = 3 then
            for j% := 0 to nJF%-1 do
                for m% := 0 to 1 do 'this is orientation of S1-targ
                    for n% := 0 to laNRepeats%-1 do
                        laTarget1Loc%[tc%] := JF%[j%]+1;  'Target location is same as stimulus location, 1 or 2
                        laTarget2Loc%[tc%] := 4;  'Target 2 is always loc2a
                        laLocsPresent%[tc%] := 1+2+4;  'Both S1s, one S2 present on every trial
                        laPage1Draw%[tc%] := 1+2+4;  'All three stimuli are on page 1
                        if m% = 0 then  'say "0" = Ortho and "1" = Iso
                            laPage1Ortho%[tc%] := JF%[j%]+1+4;  'Target S1 location is orthogonal, so target is also orthogonal
                        else
                            laPage1Ortho%[tc%] := 2-JF%[j%];  'Nontarget S1 location is orthogonal
                        endif
                        
                        if JF%[j%] = 0 then
                            if m% = 0 then  'target is ortho (we could get more clever about constructing this, but just doing this will be easier and faster
                                laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Target, Ortho; ";
                                laInitialST$[tc%] += "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Dist; ";
                            else
                                laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Target; ";
                                laInitialST$[tc%] += "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Dist, Ortho; ";
                            endif
                        else
                            if m% = 0 then
                                laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Target, Ortho; ";
                                laInitialST$[tc%] += "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Dist; ";
                            else
                                laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Target; ";
                                laInitialST$[tc%] += "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Dist, Ortho; ";
                            endif
                        endif
                        'The S2 location is the same regardless of whether the S1 is in the JAWS field or not, but may or may not be orthogonal to JFPref
                        if m% = 0 then
                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + ", Ortho; ";
                        else
                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + "; ";
                        endif
                        
                        tc% += 1;  'Increment index
                    next
                next
            next
        case laTrainingStageDS2S1% = 4 then
            for j% := 0 to nJF%-1 do
                for m% := 0 to 1 do 'this is orientation of S1-targ
                    for n% := 0 to laNRepeats%-1 do
                        laTarget1Loc%[tc%] := JF%[j%]+1;  'Target location is same as stimulus location, 1 or 2
                        laTarget2Loc%[tc%] := 4;  'Target 2 is always loc2a
                        laLocsPresent%[tc%] := 1+2+4;  'Both S1s, one S2 present on every trial
                        laPage1Draw%[tc%] := 4;  'This step begins the stages where we present loc2a first
                        laPage2Draw%[tc%] := 1+2+4;  'Both S1s, one S2 present on page 2
                        if m% = 0 then  'If S1-target is Ortho
                            laPage1Ortho%[tc%] := 4;  'The S2-target must be ortho
                            laPage2Ortho%[tc%] := JF%[j%]+1+4;  'On page 2 both S1-target and S2-target must be ortho
                        else
                            laPage2Ortho%[tc%] := 2-JF%[j%];  'S1-Nontarget (only present on page 2) is ortho
                        endif
                        
                        'The S2 location is the same regardless of whether the S1 is in the JAWS field or not (put it first, it's up first)
                        if m% = 0 then
                            laInitialST$[tc%] := "S2 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + ", Ortho; ";
                        else
                            laInitialST$[tc%] := "S2 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + "; ";
                        endif
                        if JF%[j%] = 0 then
                            if m% = 0 then  'target is ortho (we could get more clever about constructing this, but just doing this will be easier and faster
                                laInitialST$[tc%] += "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Target, Ortho; ";
                                laInitialST$[tc%] += "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Dist; ";
                            else
                                laInitialST$[tc%] += "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Target; ";
                                laInitialST$[tc%] += "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Dist, Ortho; ";
                            endif
                        else
                            if m% = 0 then
                                laInitialST$[tc%] += "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Target, Ortho; ";
                                laInitialST$[tc%] += "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Dist; ";
                            else
                                laInitialST$[tc%] += "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Target; ";
                                laInitialST$[tc%] += "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Dist, Ortho; ";
                            endif
                        endif
                        
                        tc% += 1;  'Increment index
                    next
                next
            next
        case laTrainingStageDS2S1% = 5 then
            for i% := 0 to nJ%-1 do
                for j% := 0 to nJF%-1 do
                    for m% := 0 to 1 do 'this is orientation of S1-targ
                        for n% := 0 to laNRepeats%-1 do
                            laTarget1Loc%[tc%] := JF%[j%]+1;  'Target location is same as stimulus location, 1 or 2
                            laTarget2Loc%[tc%] := 4;  'Target 2 is always loc2a
                            laLocsPresent%[tc%] := 1+2+4;  'Both S1s, one S2 present on every trial
                            laPage1Draw%[tc%] := 4;  'Page 1, present loc2a first
                            laPage2Draw%[tc%] := 1+2+4;  'Show all stimuli on page 2
                            laPage3Draw%[tc%] := 1+2+4;  'Show all stimuli on page 3
                            laPage3Fade%[tc%] := 1+2+4;  'Fading all stimuli
                            if m% = 0 then  'If S1-target is Ortho
                                laPage1Ortho%[tc%] := 4;  'The S2-target must be ortho
                                laPage2Ortho%[tc%] := JF%[j%]+1+4;  'On page 2 both S1-target and S2-target must be ortho
                                laPage3Ortho%[tc%] := JF%[j%]+1+4;  'On page 3 both S1-target and S2-target must be ortho
                            else
                                laPage2Ortho%[tc%] := 2-JF%[j%];  'S1-Nontarget (only present on page 2/3) is ortho
                                laPage3Ortho%[tc%] := 2-JF%[j%];  'S1-Nontarget (only present on page 2/3) is ortho
                            endif
                            laOptoThisTrial%[tc%] := JAWS%[i%];  'JAWS yes/no 1/0
                            
                            'The S2 location is the same regardless of whether the S1 is in the JAWS field or not (put it first, it's up first)
                            if m% = 0 then
                                laInitialST$[tc%] := "S2 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + ", Ortho, Fade out; ";
                            else
                                laInitialST$[tc%] := "S2 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + ", Fade out; ";
                            endif
                            if JF%[j%] = 0 then
                                if m% = 0 then  'target is ortho (we could get more clever about constructing this, but just doing this will be easier and faster
                                    laInitialST$[tc%] += "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Target, Ortho, Fade out; ";
                                    laInitialST$[tc%] += "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Dist, Fade out; ";
                                else
                                    laInitialST$[tc%] += "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Target, Fade out; ";
                                    laInitialST$[tc%] += "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Dist, Ortho, Fade out; ";
                                endif
                            else
                                if m% = 0 then
                                    laInitialST$[tc%] += "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Target, Ortho, Fade out; ";
                                    laInitialST$[tc%] += "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Dist, Fade out; ";
                                else
                                    laInitialST$[tc%] += "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Target, Fade out; ";
                                    laInitialST$[tc%] += "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Dist, Ortho, Fade out; ";
                                endif
                            endif
                            'The JAWS status is independent of whether the stimulus is in the JAWS field
                            laInitialST$[tc%] += "JAWS = " + Str$(JAWS%[i%]) + "; ";
                            
                            tc% += 1;  'Increment index
                        next
                    next
                next
            next
        case laTrainingStageDS2S1% = 6 then
            for i% := 0 to nJ%-1 do
                for j% := 0 to nJF%-1 do
                    for m% := 0 to 1 do 'this is orientation of S1-targ
                        for n% := 0 to laNRepeats%-1 do
                            laTarget1Loc%[tc%] := JF%[j%]+1;  'Target location is same as stimulus location, 1 or 2
                            laTarget2Loc%[tc%] := 4;  'Target 2 is always loc2a
                            laLocsPresent%[tc%] := 1+2+4;  'Both S1s, one S2 present on every trial
                            laPage1Draw%[tc%] := 4;  'This step begins the stages where we present loc2a first
                            laPage2Draw%[tc%] := 1+2+4;  'Both S1s, one S2 present on page 2
                            if m% = 0 then  'If S1-target is Ortho
                                laPage1Ortho%[tc%] := 4;  'The S2-target must be ortho
                                laPage2Ortho%[tc%] := JF%[j%]+1+4;  'On page 2 both S1-target and S2-target must be ortho
                            else
                                laPage2Ortho%[tc%] := 2-JF%[j%];  'S1-Nontarget (only present on page 2) is ortho
                            endif
                            laOptoThisTrial%[tc%] := JAWS%[i%];  'JAWS yes/no 1/0
                            
                            'The S2 location is the same regardless of whether the S1 is in the JAWS field or not (put it first, it's up first)
                            if m% = 0 then
                                laInitialST$[tc%] := "S2 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + ", Ortho; ";
                            else
                                laInitialST$[tc%] := "S2 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + "; ";
                            endif
                            if JF%[j%] = 0 then
                                if m% = 0 then  'target is ortho (we could get more clever about constructing this, but just doing this will be easier and faster
                                    laInitialST$[tc%] += "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Target, Ortho; ";
                                    laInitialST$[tc%] += "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Dist; ";
                                else
                                    laInitialST$[tc%] += "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Target; ";
                                    laInitialST$[tc%] += "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Dist, Ortho; ";
                                endif
                            else
                                if m% = 0 then
                                    laInitialST$[tc%] += "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Target, Ortho; ";
                                    laInitialST$[tc%] += "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Dist; ";
                                else
                                    laInitialST$[tc%] += "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Target; ";
                                    laInitialST$[tc%] += "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Dist, Ortho; ";
                                endif
                            endif
                            'The JAWS status is independent of whether the stimulus is in the JAWS field
                            laInitialST$[tc%] += "JAWS = " + Str$(JAWS%[i%]) + "; ";

                            tc% += 1;  'Increment index
                        next
                    next
                next
            next
        endcase
    case laExperimentType% = 3 then
        docase
        case laTrainingStageDS2S2% = 0 then
            for j% := 0 to nJF%-1 do
                for n% := 0 to laNRepeats%-1 do
                    laTarget1Loc%[tc%] := JF%[j%]+1;  'Target location is same as stimulus location, 1 or 2
                    laLocsPresent%[tc%] := JF%[j%]+1;  'Only location present is stimulus location, 1 or 2
                    laPage1Draw%[tc%] := JF%[j%]+1;  'Only location present on page 1 is stimulus location, 1 or 2
                    
                    if JF%[j%] = 0 then
                        laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + "; ";
                    else
                        laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + "; ";
                    endif
                    
                    tc% += 1;  'Increment index
                next
            next
        case laTrainingStageDS2S2% = 1 then
            for j% := 0 to nJF%-1 do
                for k% := 0 to nS%-1 do
                    for n% := 0 to laNRepeats%-1 do
                        laTarget1Loc%[tc%] := JF%[j%]+1;  'Target location is same as stimulus location, 1 or 2
                        laPage1Draw%[tc%] := JF%[j%]+1;  'Only location present on page 1 is stimulus location, 1 or 2
                        if k% = 1 then  'k%=1 is one-saccade only
                            laLocsPresent%[tc%] := JF%[j%]+1;  'Only location present is S1 location, 1 or 2
                            laPage2Draw%[tc%] := 0;  'Nothing to draw on page 2
                            laPage3Draw%[tc%] := 0;  'Nothing to draw on page 3
                            laTarget2Loc%[tc%] := 0;  'No second target
                        else  'k%=0 is two-saccade
                            laLocsPresent%[tc%] := JF%[j%]+1+4;  'The stimulus location is present (1 or 2 = JF%[j%]+1) and loc2a is present (4)
                            laPage2Draw%[tc%] := JF%[j%]+1+4;  'same as locs present
                            laPage3Draw%[tc%] := 4;  'Page 3 is only the S2 in loc2a
                            laTarget2Loc%[tc%] := 4;  'Loc2a is always target
                        endif
                                                
                        if JF%[j%] = 0 then
                            laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + "; ";
                        else
                            laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + "; ";
                        endif
                        'The S2 location is the same regardless of whether the S1 is in the JAWS field or not
                        if k% = 0 then  
                            laInitialST$[tc%] += "S2 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + "; ";
                        endif
                        
                        tc% += 1;  'Increment index
                    next
                next
            next
        case laTrainingStageDS2S2% = 2 then
            for j% := 0 to nJF%-1 do
                for n% := 0 to laNRepeats%-1 do
                    laTarget1Loc%[tc%] := JF%[j%]+1;  'Target location is same as stimulus location, 1 or 2
                    laTarget2Loc%[tc%] := 4;  'Loc2a is always target while loc2b is being faded in
                    laLocsPresent%[tc%] := JF%[j%]+1+4+8;  'Target location, plus both S2s present
                    laPage1Draw%[tc%] := JF%[j%]+1;  'Only location present on page 1 is stimulus location, 1 or 2
                    laPage2Draw%[tc%] := JF%[j%]+1+4+8;  'Target location, plus both S2s present on page 2
                    laPage3Draw%[tc%] := 4+8;  'Dropping S1 (after saccade to S1)
                    laPage2Fade%[tc%] := 8;  'Fading in Loc2b
                    laPage3Fade%[tc%] := 8;  'Fading in Loc2b
                    laPage2Ortho%[tc%] := 8;  'Loc2b is orthogonal while fading in
                    laPage3Ortho%[tc%] := 8;  'Loc2b is orthogonal while fading in
                    
                    if JF%[j%] = 0 then
                        laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + "; ";
                    else
                        laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + "; ";
                    endif
                    'The S2 locations are the same regardless of whether the S1 is in the JAWS field or not
                    laInitialST$[tc%] += "S2 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + ", Target; ";
                    laInitialST$[tc%] += "S2 x = " + Str$(laLoc2bXDeg) + ", y = " + Str$(laLoc2bYDeg) + ", Dist, Fade in; ";
                    
                    tc% += 1;  'Increment index
                next
            next
        case laTrainingStageDS2S2% = 3 then
            for j% := 0 to nJF%-1 do
                for m% := 0 to 1 do 'this is orientation of S1-cue
                    for n% := 0 to laNRepeats%-1 do
                        tempTarg% := 4 + (4*round(rand()));  'place S2-target in position 4 or 8 randomly
                        laTarget1Loc%[tc%] := JF%[j%]+1;  'Target 1 location is same as stimulus location, 1 or 2
                        laTarget2Loc%[tc%] := tempTarg%;  'Target 2 location is determined just above
                        laLocsPresent%[tc%] := JF%[j%]+1+4+8;  'S1 plus both S2s present
                        laPage1Draw%[tc%] := JF%[j%]+1+4+8;  'S1 plus both S2s present on page 1
                        if m% = 0 then  'S1-cue is ortho
                            laPage1Ortho%[tc%] := JF%[j%]+1+tempTarg%;  'S1-Cue location and S2-target location are ortho
                        else
                            laPage1Ortho%[tc%] := 12-tempTarg%;  'S2-distractor location is ortho, 12-tempTarg% works
                        endif
                        
                        if JF%[j%] = 0 then
                            if m% = 0 then
                                laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Ortho; ";
                            else
                                laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + "; ";
                            endif
                        else
                            if m% = 0 then
                                laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Ortho; ";
                            else
                                laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + "; ";
                            endif
                        endif
                        if m% = 0 then 'if target is ortho
                            if tempTarg% = 4 then  'if S2 target is loc2a
                                laInitialST$[tc%] += "S2 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + ", Target, Ortho; ";
                                laInitialST$[tc%] += "S2 x = " + Str$(laLoc2bXDeg) + ", y = " + Str$(laLoc2bYDeg) + ", Dist; ";
                            else
                                laInitialST$[tc%] += "S2 x = " + Str$(laLoc2bXDeg) + ", y = " + Str$(laLoc2bYDeg) + ", Target, Ortho; ";
                                laInitialST$[tc%] += "S2 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + ", Dist; ";
                            endif
                        else  'if target is Iso
                            if tempTarg% = 4 then
                                laInitialST$[tc%] += "S2 x = " + Str$(laLoc2bXDeg) + ", y = " + Str$(laLoc2bYDeg) + ", Target; ";
                                laInitialST$[tc%] += "S2 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + ", Dist, Ortho; ";
                            else
                                laInitialST$[tc%] += "S2 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + ", Target; ";
                                laInitialST$[tc%] += "S2 x = " + Str$(laLoc2bXDeg) + ", y = " + Str$(laLoc2bYDeg) + ", Dist, Ortho; ";
                            endif
                        endif
                        
                        tc% += 1;  'Increment index
                    next
                next
            next
        case laTrainingStageDS2S2% = 4 then
            for j% := 0 to nJF%-1 do
                for m% := 0 to 1 do 'this is orientation of S1-cue
                    for n% := 0 to laNRepeats%-1 do
                        tempTarg% := 4 + (4*round(rand()));  'place S2-target in position 4 or 8 randomly
                        laTarget1Loc%[tc%] := JF%[j%]+1;  'Target 1 location is same as stimulus location, 1 or 2
                        laTarget2Loc%[tc%] := tempTarg%;  'Target 2 location is determined just above
                        laLocsPresent%[tc%] := JF%[j%]+1+4+8;  'S1 plus both S2s present
                        laPage1Draw%[tc%] := 4+8;  'Both S2s present on page 2
                        laPage2Draw%[tc%] := JF%[j%]+1+4+8;  'S1 plus both S2s present on page 2
                        if m% = 0 then  'S1-cue is ortho
                            laPage1Ortho%[tc%] := tempTarg%;  'S2-target location is ortho
                            laPage2Ortho%[tc%] := JF%[j%]+1+tempTarg%;  'S1-Cue location and S2-target location are ortho
                        else
                            laPage1Ortho%[tc%] := 12-tempTarg%;  'S2-distractor location is ortho, 12-tempTarg% works
                            laPage2Ortho%[tc%] := 12-tempTarg%;  
                        endif
                        
                        if JF%[j%] = 0 then
                            if m% = 0 then
                                laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Ortho; ";
                            else
                                laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + "; ";
                            endif
                        else
                            if m% = 0 then
                                laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Ortho; ";
                            else
                                laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + "; ";
                            endif
                        endif
                        if m% = 0 then 'if target is ortho
                            if tempTarg% = 4 then  'if S2 target is loc2a
                                laInitialST$[tc%] += "S2 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + ", Target, Ortho; ";
                                laInitialST$[tc%] += "S2 x = " + Str$(laLoc2bXDeg) + ", y = " + Str$(laLoc2bYDeg) + ", Dist; ";
                            else
                                laInitialST$[tc%] += "S2 x = " + Str$(laLoc2bXDeg) + ", y = " + Str$(laLoc2bYDeg) + ", Target, Ortho; ";
                                laInitialST$[tc%] += "S2 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + ", Dist; ";
                            endif
                        else  'if target is Iso
                            if tempTarg% = 4 then
                                laInitialST$[tc%] += "S2 x = " + Str$(laLoc2bXDeg) + ", y = " + Str$(laLoc2bYDeg) + ", Target; ";
                                laInitialST$[tc%] += "S2 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + ", Dist, Ortho; ";
                            else
                                laInitialST$[tc%] += "S2 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + ", Target; ";
                                laInitialST$[tc%] += "S2 x = " + Str$(laLoc2bXDeg) + ", y = " + Str$(laLoc2bYDeg) + ", Dist, Ortho; ";
                            endif
                        endif
                        
                        tc% += 1;  'Increment index
                    next
                next
            next
        case laTrainingStageDS2S2% = 5 then
            for i% := 0 to nJ%-1 do
                for j% := 0 to nJF%-1 do
                    for m% := 0 to 1 do 'this is orientation of S1-cue
                        for n% := 0 to laNRepeats%-1 do
                            tempTarg% := 4 + (4*round(rand()));  'place S2-target in position 4 or 8 randomly
                            laTarget1Loc%[tc%] := JF%[j%]+1;  'Target 1 location is same as stimulus location, 1 or 2
                            laTarget2Loc%[tc%] := tempTarg%;  'Target 2 location is determined just above
                            laLocsPresent%[tc%] := JF%[j%]+1+4+8;  'S1 plus both S2s present
                            laPage1Draw%[tc%] := 4+8;  'Both S2s present on page 2
                            laPage2Draw%[tc%] := JF%[j%]+1+4+8;  'S1 plus both S2s present on page 2
                            laPage3Draw%[tc%] := JF%[j%]+1+4+8;  'S1 plus both S2s present on page 3
                            laPage3Fade%[tc%] := JF%[j%]+1+4+8;  'S1 plus both S2s all fade on page 3
                            if m% = 0 then  'S1-cue is ortho
                                laPage1Ortho%[tc%] := tempTarg%;  'S2-target location is ortho
                                laPage2Ortho%[tc%] := JF%[j%]+1+tempTarg%;  'S1-Cue location and S2-target location are ortho
                                laPage3Ortho%[tc%] := JF%[j%]+1+tempTarg%;  'S1-Cue location and S2-target location are ortho
                            else
                                laPage1Ortho%[tc%] := 12-tempTarg%;  'S2-distractor location is ortho, 12-tempTarg% works
                                laPage2Ortho%[tc%] := 12-tempTarg%;  
                                laPage3Ortho%[tc%] := 12-tempTarg%; 
                            endif
                            laOptoThisTrial%[tc%] := JAWS%[i%];  'JAWS yes/no 1/0
                            
                            if JF%[j%] = 0 then
                                if m% = 0 then
                                    laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Ortho, Fade out; ";
                                else
                                    laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Fade out; ";
                                endif
                            else
                                if m% = 0 then
                                    laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Ortho, Fade out; ";
                                else
                                    laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Fade out; ";
                                endif
                            endif
                            if m% = 0 then 'if target is ortho
                                if tempTarg% = 4 then  'if S2 target is loc2a
                                    laInitialST$[tc%] += "S2 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + ", Target, Ortho, Fade out; ";
                                    laInitialST$[tc%] += "S2 x = " + Str$(laLoc2bXDeg) + ", y = " + Str$(laLoc2bYDeg) + ", Dist, Fade out; ";
                                else
                                    laInitialST$[tc%] += "S2 x = " + Str$(laLoc2bXDeg) + ", y = " + Str$(laLoc2bYDeg) + ", Target, Ortho, Fade out; ";
                                    laInitialST$[tc%] += "S2 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + ", Dist, Fade out; ";
                                endif
                            else  'if target is Iso
                                if tempTarg% = 4 then
                                    laInitialST$[tc%] += "S2 x = " + Str$(laLoc2bXDeg) + ", y = " + Str$(laLoc2bYDeg) + ", Target, Fade out; ";
                                    laInitialST$[tc%] += "S2 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + ", Dist, Ortho, Fade out; ";
                                else
                                    laInitialST$[tc%] += "S2 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + ", Target, Fade out; ";
                                    laInitialST$[tc%] += "S2 x = " + Str$(laLoc2bXDeg) + ", y = " + Str$(laLoc2bYDeg) + ", Dist, Ortho, Fade out; ";
                                endif
                            endif
                            'The JAWS status is independent of whether the stimulus is in the JAWS field
                            laInitialST$[tc%] += "JAWS = " + Str$(JAWS%[i%]) + "; ";
                            
                            tc% += 1;  'Increment index
                        next
                    next
                next
            next
        case laTrainingStageDS2S2% = 6 then
            for i% := 0 to nJ%-1 do
                for j% := 0 to nJF%-1 do
                    for m% := 0 to 1 do 'this is orientation of S1-cue
                        for n% := 0 to laNRepeats%-1 do
                            tempTarg% := 4 + (4*round(rand()));  'place S2-target in position 4 or 8 randomly
                            laTarget1Loc%[tc%] := JF%[j%]+1;  'Target 1 location is same as stimulus location, 1 or 2
                            laTarget2Loc%[tc%] := tempTarg%;  'Target 2 location is determined just above
                            laLocsPresent%[tc%] := JF%[j%]+1+4+8;  'S1 plus both S2s present
                            laPage1Draw%[tc%] := 4+8;  'Both S2s present on page 2
                            laPage2Draw%[tc%] := JF%[j%]+1+4+8;  'S1 plus both S2s present on page 2
                            if m% = 0 then  'S1-cue is ortho
                                laPage1Ortho%[tc%] := tempTarg%;  'S2-target location is ortho
                                laPage2Ortho%[tc%] := JF%[j%]+1+tempTarg%;  'S1-Cue location and S2-target location are ortho
                            else
                                laPage1Ortho%[tc%] := 12-tempTarg%;  'S2-distractor location is ortho, 12-tempTarg% works
                                laPage2Ortho%[tc%] := 12-tempTarg%;  
                            endif
                            laOptoThisTrial%[tc%] := JAWS%[i%];  'JAWS yes/no 1/0
                            
                            if JF%[j%] = 0 then
                                if m% = 0 then
                                    laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + ", Ortho; ";
                                else
                                    laInitialST$[tc%] := "S1 x = " + Str$(laLoc1aXDeg) + ", y = " + Str$(laLoc1aYDeg) + "; ";
                                endif
                            else
                                if m% = 0 then
                                    laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + ", Ortho; ";
                                else
                                    laInitialST$[tc%] := "S1 x = " + Str$(laLoc1bXDeg) + ", y = " + Str$(laLoc1bYDeg) + "; ";
                                endif
                            endif
                            if m% = 0 then 'if target is ortho
                                if tempTarg% = 4 then  'if S2 target is loc2a
                                    laInitialST$[tc%] += "S2 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + ", Target, Ortho; ";
                                    laInitialST$[tc%] += "S2 x = " + Str$(laLoc2bXDeg) + ", y = " + Str$(laLoc2bYDeg) + ", Dist; ";
                                else
                                    laInitialST$[tc%] += "S2 x = " + Str$(laLoc2bXDeg) + ", y = " + Str$(laLoc2bYDeg) + ", Target, Ortho; ";
                                    laInitialST$[tc%] += "S2 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + ", Dist; ";
                                endif
                            else  'if target is Iso
                                if tempTarg% = 4 then
                                    laInitialST$[tc%] += "S2 x = " + Str$(laLoc2bXDeg) + ", y = " + Str$(laLoc2bYDeg) + ", Target; ";
                                    laInitialST$[tc%] += "S2 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + ", Dist, Ortho; ";
                                else
                                    laInitialST$[tc%] += "S2 x = " + Str$(laLoc2aXDeg) + ", y = " + Str$(laLoc2aYDeg) + ", Target; ";
                                    laInitialST$[tc%] += "S2 x = " + Str$(laLoc2bXDeg) + ", y = " + Str$(laLoc2bYDeg) + ", Dist, Ortho; ";
                                endif
                            endif
                            'The JAWS status is independent of whether the stimulus is in the JAWS field
                            laInitialST$[tc%] += "JAWS = " + Str$(JAWS%[i%]) + "; ";
                            
                            tc% += 1;  'Increment index
                        next
                    next
                next
            next
        endcase    
    endcase
    
    'Randomize trial order
    for i% := 0 to nTrials% do
        laTrialOrder%[i%] := i%;  'Build variable with 0 to N-1 sequentially (I feel like there's a built-in way to do this but I can't find it)
    next
    '-1 option to ArrSort shuffles; is possible to include up to 18(!!) arrays to also shuffle into this identical order
    ArrSort(laTrialOrder%[0:nTrials%],-1,laTarget1Loc%[0:nTrials%],laTarget2Loc%[0:nTrials%],laLocsPresent%[0:nTrials%],
            laPage1Draw%[0:nTrials%],laPage2Draw%[0:nTrials%],laPage3Draw%[0:nTrials%],laOptoThisTrial%[0:nTrials%],
            laMicroThisTrial%[0:nTrials%],laPage1Fade%[0:nTrials%],laPage2Fade%[0:nTrials%],laPage3Fade%[0:nTrials%],
            laPage1Ortho%[0:nTrials%],laPage2Ortho%[0:nTrials%],laPage3Ortho%[0:nTrials%],laInitialST$[:nTrials%]);  
    'Currently at 16 variables being sorted!!  Only two to spare so if there are updates we need to be judicious
        
    'Write .txt file
    MultSaccHandle% := FileOpen(MultSaccFilename$,8,1);
    if MultSaccHandle% < 0 then
        printlog("Opening text file for writing failed with error %d\n",MultSaccHandle%);
        halt;
    endif;
    
    s := Seconds();
    for i% := 0 to nTrials%-1 do  'loop through every trial
        
        'Each trial is its own line.  Each trial is composed of pages.  
        'Pages are separated by " | "
        'Stimuli within each page are separated by " : "
        'Stimulus definition: " G <grating spec> "  We should be able to use a 15-value spec, include CTF even though we have it
        'Trial ends in "| END", separate by a \n
        
        'We are going to simply require each trial to have four pages.  (Rethink if we ever need a fifth page)
        'If there is no stimulus on a given page, we will pad with BKGD
        
        'Page 1 print
        DecodeLocsPresent(laPage1Draw%[i%],loc1ap%,loc1bp%,loc2ap%,loc2bp%);  'fill these four variables with 1/0 depending on whether that location is present on this page
        DecodeLocsPresent(laPage1Fade%[i%],loc1af%,loc1bf%,loc2af%,loc2bf%);  'same but 1/0 for fade
        DecodeLocsPresent(laPage1Ortho%[i%],loc1ao%,loc1bo%,loc2ao%,loc2bo%);  'same but 1/0 for orthogonal orientation
        numGratings% := loc1ap% + loc1bp% + loc2ap% + loc2bp%;
        if numGratings% = 0 then
            Print("BKGD | ");  'If no grating is present, print a blank page
        else
            colonOrNot$ := "";  'For grating separation within a page, reset at beginning of page
            if loc1ap% = 1 then  'If location 1a is present
                numGratings% -= 1;  'Decrement number of gratings
                if numGratings% > 0 then
                    colonOrNot$ := " : ";  'If there are any gratings left, separate with colon
                else
                    colonOrNot$ := " | ";  'If this is the last grating on the page, separate with pipe
                endif
                if loc1af% = 1 then 'If location 1a is faded
                    if loc1ao% = 1 then 'If location 1a is orthogonal
                        Print("G %s%s",g1afo$,colonOrNot$);  'Faded and orthogonal
                    else
                        Print("G %s%s",g1af$,colonOrNot$);   'Faded
                    endif
                else
                    if loc1ao% = 1 then 'If location 1a is orthogonal
                        Print("G %s%s",g1ao$,colonOrNot$);   'Orthogonal
                    else
                        Print("G %s%s",g1a$,colonOrNot$);    'Regular
                    endif
                endif
            endif
            if loc1bp% = 1 then  'If location 1b is present
                numGratings% -= 1;  'Decrement number of gratings
                if numGratings% > 0 then
                    colonOrNot$ := " : ";  'If there are any gratings left, separate with colon
                else
                    colonOrNot$ := " | ";  'If this is the last grating on the page, separate with pipe
                endif
                if loc1bf% = 1 then 'If location 1b is faded
                    if loc1bo% = 1 then 'If location 1b is orthogonal
                        Print("G %s%s",g1bfo$,colonOrNot$);  'Faded and orthogonal
                    else
                        Print("G %s%s",g1bf$,colonOrNot$);   'Faded
                    endif
                else
                    if loc1bo% = 1 then 'If location 1b is orthogonal
                        Print("G %s%s",g1bo$,colonOrNot$);   'Orthogonal
                    else
                        Print("G %s%s",g1b$,colonOrNot$);    'Regular
                    endif
                endif
            endif
            if loc2ap% = 1 then  'If location 2a is present
                numGratings% -= 1;  'Decrement number of gratings
                if numGratings% > 0 then
                    colonOrNot$ := " : ";  'If there are any gratings left, separate with colon
                else
                    colonOrNot$ := " | ";  'If this is the last grating on the page, separate with pipe
                endif
                if loc2af% = 1 then 'If location 2a is faded
                    if loc2ao% = 1 then 'If location 2a is orthogonal
                        Print("G %s%s",g2afo$,colonOrNot$);  'Faded and orthogonal
                    else
                        Print("G %s%s",g2af$,colonOrNot$);   'Faded
                    endif
                else
                    if loc2ao% = 1 then 'If location 2a is orthogonal
                        Print("G %s%s",g2ao$,colonOrNot$);   'Orthogonal
                    else
                        Print("G %s%s",g2a$,colonOrNot$);    'Regular
                    endif
                endif
            endif
            if loc2bp% = 1 then  'If location 2b is present
                numGratings% -= 1;  'Decrement number of gratings
                if numGratings% > 0 then
                    message("On final grating of page, numGratings did not decrement to zero!  Value is " + Str$(numGratings%) + " Uh-oh!");
                    FileClose(MultSaccHandle%);
                    halt;
                else
                    colonOrNot$ := " | ";  'If this is the last grating on the page, separate with pipe
                endif
                if loc2bf% = 1 then 'If location 2b is faded
                    if loc2bo% = 1 then 'If location 2b is orthogonal
                        Print("G %s%s",g2bfo$,colonOrNot$);  'Faded and orthogonal
                    else
                        Print("G %s%s",g2bf$,colonOrNot$);   'Faded
                    endif
                else
                    if loc2bo% = 1 then 'If location 2b is orthogonal
                        Print("G %s%s",g2bo$,colonOrNot$);   'Orthogonal
                    else
                        Print("G %s%s",g2b$,colonOrNot$);    'Regular
                    endif
                endif
                'No more gratings on this page, don't need to update grating separator
            endif
        endif
        
        'Page 2 print
        DecodeLocsPresent(laPage2Draw%[i%],loc1ap%,loc1bp%,loc2ap%,loc2bp%);  'is-present version
        DecodeLocsPresent(laPage2Fade%[i%],loc1af%,loc1bf%,loc2af%,loc2bf%);  'fade version
        DecodeLocsPresent(laPage2Ortho%[i%],loc1ao%,loc1bo%,loc2ao%,loc2bo%);  'ortho version
        numGratings% := loc1ap% + loc1bp% + loc2ap% + loc2bp%;
        if numGratings% = 0 then
            Print("BKGD | ");  'If no grating is present, print a blank page
        else
            if loc1ap% = 1 then  'If location 1a is present
                numGratings% -= 1;  'Decrement number of gratings
                if numGratings% > 0 then
                    colonOrNot$ := " : ";  'If there are any gratings left, separate with colon
                else
                    colonOrNot$ := " | ";  'If this is the last grating on the page, separate with pipe
                endif
                if loc1af% = 1 then 'If location 1a is faded
                    if loc1ao% = 1 then 'If location 1a is orthogonal
                        Print("G %s%s",g1afo$,colonOrNot$);  'Faded and orthogonal
                    else
                        Print("G %s%s",g1af$,colonOrNot$);   'Faded
                    endif
                else
                    if loc1ao% = 1 then 'If location 1a is orthogonal
                        Print("G %s%s",g1ao$,colonOrNot$);   'Orthogonal
                    else
                        Print("G %s%s",g1a$,colonOrNot$);    'Regular
                    endif
                endif
            endif
            if loc1bp% = 1 then  'If location 1b is present
                numGratings% -= 1;  'Decrement number of gratings
                if numGratings% > 0 then
                    colonOrNot$ := " : ";  'If there are any gratings left, separate with colon
                else
                    colonOrNot$ := " | ";  'If this is the last grating on the page, separate with pipe
                endif
                if loc1bf% = 1 then 'If location 1b is faded
                    if loc1bo% = 1 then 'If location 1b is orthogonal
                        Print("G %s%s",g1bfo$,colonOrNot$);  'Faded and orthogonal
                    else
                        Print("G %s%s",g1bf$,colonOrNot$);   'Faded
                    endif
                else
                    if loc1bo% = 1 then 'If location 1b is orthogonal
                        Print("G %s%s",g1bo$,colonOrNot$);   'Orthogonal
                    else
                        Print("G %s%s",g1b$,colonOrNot$);    'Regular
                    endif
                endif
            endif
            if loc2ap% = 1 then  'If location 2a is present
                numGratings% -= 1;  'Decrement number of gratings
                if numGratings% > 0 then
                    colonOrNot$ := " : ";  'If there are any gratings left, separate with colon
                else
                    colonOrNot$ := " | ";  'If this is the last grating on the page, separate with pipe
                endif
                if loc2af% = 1 then 'If location 2a is faded
                    if loc2ao% = 1 then 'If location 2a is orthogonal
                        Print("G %s%s",g2afo$,colonOrNot$);  'Faded and orthogonal
                    else
                        Print("G %s%s",g2af$,colonOrNot$);   'Faded
                    endif
                else
                    if loc2ao% = 1 then 'If location 2a is orthogonal
                        Print("G %s%s",g2ao$,colonOrNot$);   'Orthogonal
                    else
                        Print("G %s%s",g2a$,colonOrNot$);    'Regular
                    endif
                endif
            endif
            if loc2bp% = 1 then  'If location 2b is present
                numGratings% -= 1;  'Decrement number of gratings
                if numGratings% > 0 then
                    message("On final grating of page, numGratings did not decrement to zero!  Value is " + Str$(numGratings%) + " Uh-oh!");
                    FileClose(MultSaccHandle%);
                    halt;
                else
                    colonOrNot$ := " | ";  'If this is the last grating on the page, separate with pipe
                endif
                if loc2bf% = 1 then 'If location 2b is faded
                    if loc2bo% = 1 then 'If location 2b is orthogonal
                        Print("G %s%s",g2bfo$,colonOrNot$);  'Faded and orthogonal
                    else
                        Print("G %s%s",g2bf$,colonOrNot$);   'Faded
                    endif
                else
                    if loc2bo% = 1 then 'If location 2b is orthogonal
                        Print("G %s%s",g2bo$,colonOrNot$);   'Orthogonal
                    else
                        Print("G %s%s",g2b$,colonOrNot$);    'Regular
                    endif
                endif
                'No more gratings on this page, don't need to update grating separator
            endif
        endif
        
        'Page 3 print
        DecodeLocsPresent(laPage3Draw%[i%],loc1ap%,loc1bp%,loc2ap%,loc2bp%);  'is-present version
        DecodeLocsPresent(laPage3Fade%[i%],loc1af%,loc1bf%,loc2af%,loc2bf%);  'fade version
        DecodeLocsPresent(laPage3Ortho%[i%],loc1ao%,loc1bo%,loc2ao%,loc2bo%);  'ortho version
        numGratings% := loc1ap% + loc1bp% + loc2ap% + loc2bp%;
        if numGratings% = 0 then
            Print("BKGD | ");  'If no grating is present, print a blank page
        else
            if loc1ap% = 1 then  'If location 1a is present
                numGratings% -= 1;  'Decrement number of gratings
                if numGratings% > 0 then
                    colonOrNot$ := " : ";  'If there are any gratings left, separate with colon
                else
                    colonOrNot$ := " | ";  'If this is the last grating on the page, separate with pipe
                endif
                if loc1af% = 1 then 'If location 1a is faded
                    if loc1ao% = 1 then 'If location 1a is orthogonal
                        Print("G %s%s",g1afo$,colonOrNot$);  'Faded and orthogonal
                    else
                        Print("G %s%s",g1af$,colonOrNot$);   'Faded
                    endif
                else
                    if loc1ao% = 1 then 'If location 1a is orthogonal
                        Print("G %s%s",g1ao$,colonOrNot$);   'Orthogonal
                    else
                        Print("G %s%s",g1a$,colonOrNot$);    'Regular
                    endif
                endif
            endif
            if loc1bp% = 1 then  'If location 1b is present
                numGratings% -= 1;  'Decrement number of gratings
                if numGratings% > 0 then
                    colonOrNot$ := " : ";  'If there are any gratings left, separate with colon
                else
                    colonOrNot$ := " | ";  'If this is the last grating on the page, separate with pipe
                endif
                if loc1bf% = 1 then 'If location 1b is faded
                    if loc1bo% = 1 then 'If location 1b is orthogonal
                        Print("G %s%s",g1bfo$,colonOrNot$);  'Faded and orthogonal
                    else
                        Print("G %s%s",g1bf$,colonOrNot$);   'Faded
                    endif
                else
                    if loc1bo% = 1 then 'If location 1b is orthogonal
                        Print("G %s%s",g1bo$,colonOrNot$);   'Orthogonal
                    else
                        Print("G %s%s",g1b$,colonOrNot$);    'Regular
                    endif
                endif
            endif
            if loc2ap% = 1 then  'If location 2a is present
                numGratings% -= 1;  'Decrement number of gratings
                if numGratings% > 0 then
                    colonOrNot$ := " : ";  'If there are any gratings left, separate with colon
                else
                    colonOrNot$ := " | ";  'If this is the last grating on the page, separate with pipe
                endif
                if loc2af% = 1 then 'If location 2a is faded
                    if loc2ao% = 1 then 'If location 2a is orthogonal
                        Print("G %s%s",g2afo$,colonOrNot$);  'Faded and orthogonal
                    else
                        Print("G %s%s",g2af$,colonOrNot$);   'Faded
                    endif
                else
                    if loc2ao% = 1 then 'If location 2a is orthogonal
                        Print("G %s%s",g2ao$,colonOrNot$);   'Orthogonal
                    else
                        Print("G %s%s",g2a$,colonOrNot$);    'Regular
                    endif
                endif
            endif
            if loc2bp% = 1 then  'If location 2b is present
                numGratings% -= 1;  'Decrement number of gratings
                if numGratings% > 0 then
                    message("On final grating of page, numGratings did not decrement to zero!  Value is " + Str$(numGratings%) + " Uh-oh!");
                    FileClose(MultSaccHandle%);
                    halt;
                else
                    colonOrNot$ := " | ";  'If this is the last grating on the page, separate with pipe
                endif
                if loc2bf% = 1 then 'If location 2b is faded
                    if loc2bo% = 1 then 'If location 2b is orthogonal
                        Print("G %s%s",g2bfo$,colonOrNot$);  'Faded and orthogonal
                    else
                        Print("G %s%s",g2bf$,colonOrNot$);   'Faded
                    endif
                else
                    if loc2bo% = 1 then 'If location 2b is orthogonal
                        Print("G %s%s",g2bo$,colonOrNot$);   'Orthogonal
                    else
                        Print("G %s%s",g2b$,colonOrNot$);    'Regular
                    endif
                endif
                'No more gratings on this page, don't need to update grating separator
            endif
        endif
        
        'Page 4 print, and end of trial
        Print("BKGD | END\n");  'Page 4 is always blank. Close line, end of trial.  
        
    next
    
    FileClose(MultSaccHandle%);
    printlog("A total of %d trials required %f seconds to create and write to text file!\n",nTrials%,Seconds()-s);
    
    'Halt for testing, file write has been basically verified
    'message("Testing!  Halting after writing .txt!");
    'halt;
    
    'Start sampling *after* building the big text file - not that it should take any appreciable time
    
    if UseTwo1401s% = 1 then
        SampleStart(0);  'Set sampling to start immediately
        Yield(0.5);  'Wait half a second
        'Look for handshake, unless disabled
        while pulseFound% < 1 and startSecs > 0 and Dual1401IgnoreHandshake% = 0 do
            pulseFound% := View(DataWindow%).FindPulseUp%(TimingChannel%, 0, tRise, tFall);
            yield(0.1);
            startSecs := startSecs - 0.1;
        wend
        'Send timing pulse
        SampleSeqVar(11,20);  'set for 20 ms pulse (Was not specified!  Two 1401s has been inactive for years and "T" may have been accidentally co-opted?)
        SafeSampleKey("T");
    else
        SampleStart(0); 'Start sampling now
    endif;
    
    if startSecs <= 0 then
        message("Handshake not found in 5 seconds!  Quitting!");
        halt
    endif
    
    
    if laDoOpto% = 1 then
        'set sequencer variable 4 for opto voltage
        'Please note that the input for this has to be a 32-bit variable. Use vdac32% to get the right value.
        voltageInteger% := vdac32%(laOptoVoltageOut, 1, 0);
        SampleSeqVar(4,voltageInteger%);
        printlog("Voltage integer is %d\n",voltageInteger%);
    endif;
    
    
    'Set sequencer variable 5, this value is appropriate for no rivalry
    SampleSeqVar(5, 0);
    
    
	' Set Sequencer Variable #3 based on juicer type 
    SetJuicerSequencerVariable%();
    ' Clear any trigger bits on digout lines.
    SafeSampleKey("0");
    
    'Get the clock period of the sequencer, in MS, must do this after starting sampling
    SequencerPeriodMS := SampleSeqClock(1);  'This variable may go unused, but just in case...
    
    
    'Begin building the command line argument
    Opener$ := "cmd /k " + bin$;

    'Get remote args, program name
    if GetUseRemoteStimulus%() = 1 then
        ProgName$ := "\\remote.exe "; 'set program name for one VSG
        RemoteArg$  := " " + GetRemoteStimulusIP$() + " " + GetRemoteStimulusPort$() + " fixstim ";
    else
        Message("You must select Use Remote Stimulus in Config-->DAQ to use this script!");
        halt;
    endif;
    
    'Set verbosity, for now I don't think we want verbose (" -v ") on
    Verbose$ := ""; 
    
    'Set trigger port
    TriggerPort$ := " -p 2 ";  'This one's hard-coded for now (kinda for always)
    
    'Set background color, right now we'll hard code to gray
    BGColor$ := " -b gray ";
    
    'Set distance to screen
    Dist2Screen$ := " -d " + GetDistanceToScreenMM$();
    
    'Get fixation argument
    FixationArg$ := GetFixationArg$();
    
    'Set multi-saccade option
    MultSacc$ := " --multi-sac ";
    
    
    'Build command line
    CommandLine$ := Opener$ + ProgName$ + RemoteArg$ + Verbose$ + TriggerPort$ + FixationArg$ + BGColor$ + Dist2Screen$ + MultSacc$ + MultSaccFilename$;
    
    
    ' Initial text marks
    ' djs Always version 3. NO difference if maintainmode is used or not. 
    SampleText("LookAway,3," + str$(Len(CommandLine$)));
    'SampleText(laCVSID$);  'Like, we don't even do this anymore
    for i% := 1 to Len(CommandLine$) step 100 do
        SampleText(Mid$(CommandLine$, i%, 100));
    next 
    
    
    'Begin the stimulus program. It will take a few seconds for the VSG to initialize.
    PrintLog(CommandLine$+"\n");
    StimHandle% := ProgRun(CommandLine$,1);
    if StimHandle% <0 then 
        Message("Could not start stimulus."); 
        halt; 
    endif


    'If we are asking the eyetracker to record an output file, open the file and start recording
    if RecordEyeTrackerOutputFile% = 1 then
        SafeSampleKey("I");  'Open the file (this is done by setting a DIGLOW bit), file name will be saved in a sampletext
        yield(0.5);
        SafeSampleKey("W");  'Begin recording the file
        yield(0.5);
    endif
    
    
	ToolbarSet(0,"",IdleProcessing%);	'Enable the IdleProcessing function
	ToolbarEnable(2,1);  'Enable Stop
	ToolbarEnable(1,0);  'Disable Start
    ToolbarEnable(4,0);  'Disable Quit, must use Stop
	View(DataWindow%);
	Yield(5); 'Wait a few seconds to make sure the VSG has time to initialize.
	return 1;
end;


'''''StartPlexon'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
func StartPlexon%()
    
    var fp$;  'to hold current file path
    fp$ := SetPathToScriptDirectory$();
    CreateSampleConfiguration();    
    
    StartSecondInstanceOfSpike2();
    
    FilePathSet(fp$);  'change the file path back to what it was
    fp$ := FilePath$();  'read out to allow verification
    printlog("%s\n",fp$); 'and tell the world to verify
    
    ToolbarSet(1,"Start SECOND",Start%);  'change button 1 on the toolbar, this may not work
    
    ' Get display windows ready
    InitializeWindows();    
    
    return 1; 'stay in toolbar    
    
end






''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
' Run real time analysis here. 
func IdleProcessing%()
	var iStatus% := 1;	' this is return value. value of 1 (0) continues (stops) processing
    var tOpt;
    var jtc%;   'Used as a Jaws trial count in some reward calculations
    'var tStimOn;  'tLast does not work to find stim off if we have intervening steps in the state logic, which we do.
    
	tNow := View(DataWindow%).MaxTime();
    GetAllFixationPosition(DataWindow%,XChannel%,YChannel%,XChannelPurkinje%,YChannelPurkinje%,tNow);
    
    
	' Don't update display every time. 
	' Note that this stim displays eye continuously, without erasing... 
	if tNow-tLastUpdate > .005 then
        '        if iState% = stateWaitForAnswer% and iStarPosChannel% > 0 then
        '            View(StarWindow%).XYAddData(iStarPosChannel%, xEye, yEye);
        '        endif
        UpdateFixationDisplay(XYWindow%);
		tLastUpdate := tNow;
	endif

    ' What state are we in? 
    docase 
        
    case iState% = stateVSGWait% then
        if View(DataWindow%).FindPulseUp%(ReadyChannel%, -1, tTrigger, tFall) = 1 then
            LogStatus("VSGWait", "Got ready pulse at exactly " + str$(tTrigger));
            ChangeStateTo(stateStartTrial%, tNow);
            if RecordEyeTrackerOutputFile% = 1 then
                'Give pattern of four pulses - this is the initializing pattern for both the NIC EEG file and the eyetracker file
                SafeSampleKey("1");
                yield(0.2);
                SafeSampleKey("1");
                yield(0.2);
                SafeSampleKey("1");
                yield(0.2);
                SafeSampleKey("1");
                yield(0.2);
            endif;
            
            tc% := -1;  'When entering the idle loop, reset the trial counter
            
        endif
        
    '----////----\\\\----////----\\\\----////----\\\\--State Break!!--////----\\\\----////----\\\\----////----\\\\
        
    case iState% = stateStartTrial% then
        'put timing marker in both eyetracker file, smr file
        if RecordEyeTrackerOutputFile% = 1 then
            docase
            case HBCycle% = 1 then
                SafeSampleKey("1");
            case HBCycle% = 2 then
                SafeSampleKey("2");
            case HBCycle% = 3 then
                SafeSampleKey("3");
            case HBCycle% = 4 then
                SafeSampleKey("4");
            case HBCycle% = 5 then
                SafeSampleKey("5");
            case HBCycle% = 6 then
                SafeSampleKey("6");
            case HBCycle% = 7 then
                SafeSampleKey("7");
            endcase
            HBCycle% += 1;  'increment HBCycle%
            if HBCycle% = 8 then  'and cycle when necessary
                HBCycle% := 1;
            endif
            yield(0.01);  'this will likely be positioned very close to the "F" below, so give a tiny bit of time, 10 ms should be enough
        endif;
        
        
        
        tc% += 1;   'Trial counter, it's an index to the various trial variables, will be zero-based, will decrement on repeated trials
        
        
        'Randomize durations of various portions of the trial (will do it even when some portions don't exist)
        laFixationDuration := laFixationDurationMin + Rand(laFixationDurationVar, 0);
        laPage1Dur := laPage1DurationMin + Rand(laPage1DurationVar, 0);
        laPage2Dur := laPage2DurationMin + Rand(laPage2DurationVar, 0);
        laPage3Dur := laPage3DurationMin + Rand(laPage3DurationVar, 0);
        laSaccadeReleaseDelay := laSaccadeReleaseDelayMin + Rand(laSaccadeReleaseDelayVar, 0);  'Used only for full version task where stimuli are down before fixpt
        
        'For GNG experiment (id'ed here as fix down after = -1 but could also use experiment type 0)
        'we need to make the saccade acquisition time the same duration as the final page - there's
        'no fixation down to mark saccade initiaion period, it's just a change at the target that
        'triggers it.
        docase
        case laTrialFinalPage% = 2 and laFixDownAfterPage% = -1 then
            laSacc1AcqTime := laPage2Dur;
        case laTrialFinalPage% = 3 and laFixDownAfterPage% = -1 then
            laSacc1AcqTime := laPage3Dur;
        endcase
            
        
        'Recalculate tNow (in case HeartBeat code caused any noticeable delay)
        tNow := View(DataWindow%).MaxTime();
        
        'Do up trial start sampletext
        TrialStartText$ := "Trial " + Str$(tc%+1) + " Ready; " + laInitialST$[tc%];
        SampleText(TrialStartText$,tNow);
        
        'determine if we are doing opto on this trial
        if laDoOpto% = 1 then  'if 0, then laDoOptoThisTrial% will just be 0 from the jump
            if laOptoThisTrial%[tc%] = 1 then
                laDoOptoThisTrial% := 1;
                SampleText("Opto This Trial (" + Str$(tc%+1) + ")",tNow+.001);  'only sampletext for presence/absence of opto if laDoOpto% is on, no point if the whole experiment has no opto
            else
                laDoOptoThisTrial% := 0;
                SampleText("No Opto This Trial (" + Str$(tc%+1) + ")",tNow+.001);
            endif;
        endif;
        
        'determine if we are doing microstim on this trial, same logic as for opto
        if laDoMicro% = 1 then  'if 0, then laDoMicroThisTrial% will just be 0 from the jump
            if laMicroThisTrial%[tc%] = 1 then
                laDoMicroThisTrial% := 1;
                SampleText("Microstim This Trial (" + Str$(tc%+1) + ")",tNow+.002);  'offset by one ms to avoid collision with opto sampletext
            else
                laDoMicroThisTrial% := 0;
                SampleText("No Microstim This Trial (" + Str$(tc%+1) + ")",tNow+.002);
            endif;
        endif;
        
        'laTrialFinalPage% and laDoTwoSaccades% are already set, but update *only* in double-saccade training stage "2" 
        '(remember zero-based indexing here on training stages) because this stage allows mixture of single and double saccades for purposes of introduction
        if (laExperimentType% = 2 and laTrainingStageDS2S1% = 1) or (laExperimentType% = 3 and laTrainingStageDS2S2% = 1) then
            if laTarget2Loc%[tc%] > 0 then
                laTrialFinalPage% := 3;  'on two-saccade trials, stage 1, we have page 2 (S2 up) and page 3 (S1 down, release)
                laDoTwoSaccades% := 1;
            else
                laTrialFinalPage% := 1;
                laDoTwoSaccades% := 0;
            endif
        endif
        
        nTrialsStarted% += 1;
        if laDoOptoThisTrial% = 1 then
            nTrialsStartedJAWS% += 1;
        else
            nTrialsStartedNoJAWS% += 1;
        endif
        
        
        
        LogStatus("StartTrial", "Start trial #" + str$(tc%+1) + " at about " + str$(tNow) + ", Required fix time = " + str$(laFixationDuration));
        SafeSampleKey("F");  'Request Fixpt
        
        ChangeStateTo(stateWaitForFixPtOn%, tNow);         
        
    '----////----\\\\----////----\\\\----////----\\\\--State Break!!--////----\\\\----////----\\\\----////----\\\\
         
    case iState% = stateWaitForFixPtOn% then
        if View(DataWindow%).FindRisingEdge%(FixPointChannel%, tLast, tTrigger) = 0 then
            'Fixation point up. Display fix location and window.
            LogStatus("WaitForFixPt", "Fixation Point Up");
            DrawFix(1);
            SampleText("Fixpt Up",tTrigger);
            ChangeStateTo(stateWaitForAcquisition%, tNow);
        endif
        
    '----////----\\\\----////----\\\\----////----\\\\--State Break!!--////----\\\\----////----\\\\----////----\\\\
               
    case iState% = stateWaitForAcquisition% then
        if tNow-tStateStart < laFixAcquisitionTime then
            ' Acquisition happens when the eye falls within the fixation window.
            if LookingFixation%(xEye, yEye) > 0 then
                LogStatus("WaitForAcquisition", "Fixation Point Acquired");
                SampleText("Fixation Acquired",tNow);
                ChangeStateTo(stateHoldFixation%, tNow);
                
                'Turn on opto if requested at this stage - if it's not on and it starts at this stage, GO! 
                'This can't go early, if early opto is requested, so I'm moving it from starting at the hold
                'stage to ASAP once we know the fixpt is acquired, could save up to ~40 ms in the case of a
                'long chunk of time going to the OS in between idle cycles.
                if laDoOptoThisTrial% = 1 and  optoIsOn% = 0 and optoOnState% = stateHoldFixation% then
                    LogStatus("HoldFixation", "Request opto on at about " + str$(tNow));
                    SafeSampleKey("O");  'turn on opto
                    tOpt := View(DataWindow%).MaxTime();
                    printlog("OptoOn at about %f\n",tOpt);
                    SampleText("OptoOn",tOpt);  'Sampletext is approximate, opto copy channel will have record of TTL pulse
                    optoIsOn% := 1;  'Prevent opto from being turned on again
                endif
                
            endif
        else
            ' Acquisition failed. Turn off stim and try again.
            LogStatus("WaitForAcquisition", "Time out");
            ChangeStateTo(stateAbort%, tNow);
        endif        
        
    '----////----\\\\----////----\\\\----////----\\\\--State Break!!--////----\\\\----////----\\\\----////----\\\\
          
    case iState% = stateHoldFixation% then
        if LookingFixation%(xEye,yEye) <= 0 then
            LogStatus("HoldFixation", "Broken fixation at about " + str$(tNow));
            ChangeStateTo(stateAbort%, tNow);
        else
            'Once fixation hold time is complete, request stimulus (Page 1 will be first)
            if tNow - tStateStart >= laFixationDuration then
                'Turn off opto if requested at this stage - if it's on and it stops at this stage, STOP!
                if laDoOptoThisTrial% = 1 and  optoIsOn% = 1 and optoOffState% = stateHoldFixation% then
                    LogStatus("HoldFixation", "Request opto off at about " + str$(tNow));
                    SafeSampleKey("o");  'turn off opto
                    tOpt := View(DataWindow%).MaxTime();
                    printlog("OptoOff at %f\n",tOpt);
                    SampleText("OptoOff",tOpt);  'Sampletext is approximate, opto copy channel will have record of TTL pulse
                    optoIsOn% := 0;
                endif
                
                'Request stimulus immediately, HoldFixation always goes to Page 1
                tNow := View(DataWindow%).MaxTime();
                LogStatus("HoldFixation", "Request target at about " + str$(tNow));                  
                
                SafeSampleKey("S");
                laPageToggle% := 0;  'Stimulus request resets the Page toggle channel
                
                ChangeStateTo(stateWaitForPage1Up%, tNow);
            endif
            
        endif
        
    '----////----\\\\----////----\\\\----////----\\\\--State Break!!--////----\\\\----////----\\\\----////----\\\\
        
    case iState% = stateWaitForPage1Up% then
        ' Fixation may be broken while waiting for stim to come on. 
        if LookingFixation%(xEye,yEye) <= 0 then
            LogStatus("WaitForPage1Up", "Broken fixation at about " + str$(tNow));
            ChangeStateTo(stateAbort%, tNow);
        else
            ' Check if stim has come on
            if View(DataWindow%).FindRisingEdge%(StimChannel%, tLast, tTrigger) = 0 then
                'TODO - figure out if when the stimulus goes up, the page toggle channel goes from 0 to 1, or if that only happens at the first toggle!!!
                'laPageToggle% := 1 - laPageToggle%;
                LogStatus("WaitPage1Up", "Stimulus up (Page 1) at about " + str$(tNow));
                SampleText("Page 1 Up",tNow);
                'tStimOn := tTrigger;  'unused

                'Turn on opto if requested at this stage - if it's not on and it starts at this stage, GO!
                if laDoOptoThisTrial% = 1 and  optoIsOn% = 0 and optoOnState% = stateWaitThroughPage1% then
                    LogStatus("WaitPage1Up", "Request opto on at about " + str$(tNow));
                    SafeSampleKey("O");  'turn on opto
                    tOpt := View(DataWindow%).MaxTime();
                    printlog("OptoOn at %f\n",tOpt);  
                    SampleText("OptoOn",tOpt);  'Sampletext is approximate, opto copy channel will have record of TTL pulse 
                    optoIsOn% := 1;  'Prevent opto from being turned on again
                endif
                
                DrawTarget(1,1,tc%);
                
                ChangeStateTo(stateWaitThroughPage1%, tTrigger);
                
            endif
        endif
        
    '----////----\\\\----////----\\\\----////----\\\\--State Break!!--////----\\\\----////----\\\\----////----\\\\
        
    case iState% = stateWaitThroughPage1% then 
        ' Fixation may be broken while waiting through page 1 
        if LookingFixation%(xEye,yEye) <= 0 then
            LogStatus("WaitThroughPage1", "Broken fixation at about " + str$(tNow));
            ChangeStateTo(stateAbort%, tNow);
        else
            if tNow - tStateStart >= laPage1Dur then  'Page 1 done
                'Turn off opto if requested at this stage - if it's on and it stops at this stage, STOP!
                if laDoOptoThisTrial% = 1 and  optoIsOn% = 1 and optoOffState% = stateWaitThroughPage1% then
                    LogStatus("WaitThroughPage1", "Request opto off at about " + str$(tNow));
                    SafeSampleKey("o");  'turn off opto
                    tOpt := View(DataWindow%).MaxTime();
                    printlog("OptoOff at %f\n",tOpt);
                    SampleText("OptoOff",tOpt);  'Sampletext is approximate, opto copy channel will have record of TTL pulse
                    optoIsOn% := 0;
                endif
                
                docase
                    '**checked**
                case laTrialFinalPage% = 1 and laSaccadeToBlank% = 1 then  'In the case of final-stage microsaccade experiment, we take down the stimulus
                    'Give hold reward on success, if requested
                    RewardSmall%(laPSmallRewardHoldTarg); 
                    
                    'Remove stimulus, will not yet allow saccade
                    SafeSampleKey("v");  'Updated logic, we will turn the stimulus to a blank page, rather than bring it down

                    ChangeStateTo(stateWaitForFinalBlankUp%, tNow);
                    

                case laTrialFinalPage% = 1 or laFixDownAfterPage% = 1 then  'in some training steps, we bring fixation down to allow saccade 1 but targets for saccade 2 are not up yet
                    'Give hold reward on success, if requested
                    RewardSmall%(laPSmallRewardHoldTarg); 
                    
                    'Remove fixation point as saccade release
                    SafeSampleKey("f");
                    WaitForFixptOffTo(stateWaitSaccade1%,tNow);

                else
                    'Request Page 2 and wait for it to come up
                    SafeSampleKey("v");  'v will toggle to the next page
                    ChangeStateTo(stateWaitForPage2Up%, tNow);  
                endcase

            endif
        endif;
        
    '----////----\\\\----////----\\\\----////----\\\\--State Break!!--////----\\\\----////----\\\\----////----\\\\
         
    case iState% = stateWaitForPage2Up% then
        ' Fixation may be broken while waiting for Page 2 to come on. 
        if LookingFixation%(xEye,yEye) <= 0 then
            LogStatus("WaitForPage2Up", "Broken fixation at about " + str$(tNow));
            ChangeStateTo(stateAbort%, tNow);
        else
            ' Check if page has updated
            if View(DataWindow%).FindEdge%(PageToggleChannel%, tLast, tTrigger) = laPageToggle% then  'FindEdge returns 0 for a 0-->1 transition, and 1 for a 1-->0 transition!
                laPageToggle% := 1-laPageToggle%;  'update page toggle
                LogStatus("WaitPage2Up", "Stimulus up (Page 2) at about " + str$(tNow));
                SampleText("Page 2 Up",tNow);
                'tStimOn := tTrigger;  'unused

                'Turn on opto if requested at this stage - if it's not on and it starts at this stage, GO!
                if laDoOptoThisTrial% = 1 and  optoIsOn% = 0 and optoOnState% = stateWaitThroughPage2% then
                    LogStatus("WaitPage2Up", "Request opto on at about " + str$(tNow));
                    SafeSampleKey("O");  'turn on opto
                    tOpt := View(DataWindow%).MaxTime();
                    printlog("OptoOn at %f\n",tOpt);
                    SampleText("OptoOn",tOpt);  'Sampletext is approximate, opto copy channel will have record of TTL pulse
                    optoIsOn% := 1;  'Prevent opto from being turned on again
                endif
                
                DrawTarget(1,2,tc%);
                
                if laTrialFinalPage% = 2 and laFixDownAfterPage% = -1 and laTarget1Loc%[tc%] > 0 then
                    'So if we're doing GNG and this is the last page, and the stimulus is a target,
                    'we do NOT take down fixation, saccade is now allowed (note: if stimulus is 
                    'non-target we will require fixation through Page 2)
                    ChangeStateTo(stateWaitSaccade1%, tTrigger);
                else
                    ChangeStateTo(stateWaitThroughPage2%, tTrigger);
                endif

            endif
        endif    
        
    '----////----\\\\----////----\\\\----////----\\\\--State Break!!--////----\\\\----////----\\\\----////----\\\\
        
    case iState% = stateWaitThroughPage2% then 
        ' Fixation may be broken while waiting through page 2 
        if LookingFixation%(xEye,yEye) <= 0 then
            LogStatus("WaitThroughPage2", "Broken fixation at about " + str$(tNow));
            ChangeStateTo(stateAbort%, tNow);
        else
            if (tNow - tStateStart >= laPage2Dur) then  'Page 2 done
                'Turn off opto if requested at this stage - if it's on and it stops at this stage, STOP!
                if laDoOptoThisTrial% = 1 and  optoIsOn% = 1 and optoOffState% = stateWaitThroughPage2% then
                    LogStatus("WaitThroughPage2", "Request opto off at about " + str$(tNow));
                    SafeSampleKey("o");  'turn off opto
                    tOpt := View(DataWindow%).MaxTime();
                    printlog("OptoOff at %f\n",tOpt);
                    SampleText("OptoOff",tOpt);  'Sampletext is approximate, opto copy channel will have record of TTL pulse
                    optoIsOn% := 0;
                endif
                
                docase
                case laTrialFinalPage% = 2 and laSaccadeToBlank% = 1 then  'In the case of final-stage double-saccade experiment, we take down the stimulus
                    'Give hold reward on success, if requested
                    RewardSmall%(laPSmallRewardHoldTarg); 
                    
                    'Remove stimulus, will not yet allow saccade
                    SafeSampleKey("v");  'Updated logic, we will turn the stimulus to a blank page, rather than bring it down
                    
                    ChangeStateTo(stateWaitForFinalBlankUp%,tNow);
                    
                case laTrialFinalPage% = 2 and laFixDownAfterPage% = -1 and laTarget1Loc%[tc%] = 0 then    
                    'This is a no-go trial success!
                    
                    'Bring down stimulus
                    SafeSampleKey("X");
                    
                    'And move to reward
                    WaitForBlankTo(stateSuccess%, tNow);
                    
                case laTrialFinalPage% = 2 then  'If final page is 2 and not saccadeToBlank, then we remove fixpt as saccade release
                    'Give hold reward on success, if requested
                    RewardSmall%(laPSmallRewardHoldTarg); 
                    
                    'Remove fixation point as saccade release
                    SafeSampleKey("f");
                    
                    if laDoMicroThisTrial% = 1 then
                        WaitForFixptOffTo(stateGiveMicrostim%,tNow);  'When waiting for microstim saccade, we have to allow for the eyes to go cattywompus
                    else
                        WaitForFixptOffTo(stateWaitSaccade1%,tNow);
                    endif
                    
                else
                    'Request Page 3 and wait for it to come up
                    SafeSampleKey("v");  'v will toggle to the next page
                    ChangeStateTo(stateWaitForPage3Up%, tNow);  
                endcase

            endif
        endif;
        
    '----////----\\\\----////----\\\\----////----\\\\--State Break!!--////----\\\\----////----\\\\----////----\\\\
        
    case iState% = stateWaitForPage3Up% then
        ' Fixation may be broken while waiting for Page 3 to come on. 
        if LookingFixation%(xEye,yEye) <= 0 then
            LogStatus("WaitForPage3Up", "Broken fixation at about " + str$(tNow));
            ChangeStateTo(stateAbort%, tNow);
        else
            ' Check if page has updated
            if View(DataWindow%).FindEdge%(PageToggleChannel%, tLast, tTrigger) = laPageToggle% then  'FindEdge returns 0 for a 0-->1 transition, and 1 for a 1-->0 transition!
                LogStatus("WaitPage3Up", "Stimulus up (Page 3) at about " + str$(tNow));
                SampleText("Page 3 Up",tNow);
                laPageToggle% := 1-laPageToggle%;  'update page toggle
                'tStimOn := tTrigger;  'unused

                'Turn on opto if requested at this stage - if it's not on and it starts at this stage, GO!
                if laDoOptoThisTrial% = 1 and  optoIsOn% = 0 and optoOnState% = stateWaitThroughPage3% then
                    LogStatus("WaitPage3Up", "Request opto on at about " + str$(tNow));
                    SafeSampleKey("O");  'turn on opto
                    tOpt := View(DataWindow%).MaxTime();
                    printlog("OptoOn at %f\n",tOpt);
                    SampleText("OptoOn",tOpt);  'Sampletext is approximate, opto copy channel will have record of TTL pulse
                    optoIsOn% := 1;  'Prevent opto from being turned on again
                endif
                
                DrawTarget(1,3,tc%);
                
                if laTrialFinalPage% = 3 and laFixDownAfterPage% = -1 and laTarget1Loc%[tc%] > 0 then
                    'So if we're doing GNG and this is the last page, and the stimulus is a target,
                    'we do NOT take down fixation, saccade is now allowed (note: if stimulus is 
                    'non-target we will require fixation through Page 3)
                    ChangeStateTo(stateWaitSaccade1%, tTrigger);
                else
                    ChangeStateTo(stateWaitThroughPage3%, tTrigger);
                endif
                
            endif
        endif      
        
    '----////----\\\\----////----\\\\----////----\\\\--State Break!!--////----\\\\----////----\\\\----////----\\\\
        
    case iState% = stateWaitThroughPage3% then 
        ' Fixation may be broken while waiting through page 3 
        if LookingFixation%(xEye,yEye) <= 0 then
            LogStatus("WaitThroughPage3", "Broken fixation at about " + str$(tNow));
            ChangeStateTo(stateAbort%, tNow);
        else
            if (tNow - tStateStart >= laPage3Dur) then  'Page 3 done
                'Turn off opto if requested at this stage - if it's on and it stops at this stage, STOP!
                if laDoOptoThisTrial% = 1 and  optoIsOn% = 1 and optoOffState% = stateWaitThroughPage3% then
                    LogStatus("WaitThroughPage2", "Request opto off at about " + str$(tNow));
                    SafeSampleKey("o");  'turn off opto
                    tOpt := View(DataWindow%).MaxTime();
                    printlog("OptoOff at %f\n",tOpt);
                    SampleText("OptoOff",tOpt);  'Sampletext is approximate, opto copy channel will have record of TTL pulse
                    optoIsOn% := 0;
                endif
                
                docase
                case laSaccadeToBlank% = 1 then  'Any instance of a "page 4" is blank, and saccading to the blank after subsequent "f"
                    'Give hold reward on success, if requested
                    RewardSmall%(laPSmallRewardHoldTarg); 
                    
                    'Remove stimulus, will not yet allow saccade
                    SafeSampleKey("v");  'Updated logic, we will turn the stimulus to a blank page, rather than bring it down
                    
                    ChangeStateTo(stateWaitForFinalBlankUp%,tNow);
                    
                case laTrialFinalPage% = 3 and laFixDownAfterPage% = -1 and laTarget1Loc%[tc%] = 0 then    
                    'This is a no-go trial success!
                    
                    'Bring down stimulus
                    SafeSampleKey("X");
                    
                    'And move to reward
                    WaitForBlankTo(stateSuccess%, tNow);    
                    
                else
                    'Remove fixpt, and allow saccade
                    SafeSampleKey("f");
                    WaitForFixptOffTo(stateWaitSaccade1%, tNow);  
                endcase

            endif
        endif;    
        
    '----////----\\\\----////----\\\\----////----\\\\--State Break!!--////----\\\\----////----\\\\----////----\\\\
        
    case iState% = stateWaitForFinalBlankUp% then
        ' Fixation may be broken while waiting for Final Blank page to come on. 
        if LookingFixation%(xEye,yEye) <= 0 then
            LogStatus("WaitForFinalBlankUp", "Broken fixation at about " + str$(tNow));
            ChangeStateTo(stateAbort%, tNow);
        else
            ' Check if page has updated
            if View(DataWindow%).FindEdge%(PageToggleChannel%, tLast, tTrigger) = laPageToggle% then  'FindEdge returns 0 for a 0-->1 transition, and 1 for a 1-->0 transition!
                LogStatus("WaitFinalBlankPageUp", "Stimulus up (Final Blank Page) at about " + str$(tNow));
                SampleText("Final Blank Page Up",tNow);
                laPageToggle% := 1-laPageToggle%;  'update page toggle - technically not necessary as we won't check again
                'tStimOn := tTrigger;  'unused

                'Turn on opto if requested at this stage - if it's not on and it starts at this stage, GO!
                if laDoOptoThisTrial% = 1 and  optoIsOn% = 0 and optoOnState% = stateWaitForSaccadeRelease% then
                    LogStatus("WaitFinalBlankPageUp", "Request opto on at about " + str$(tNow));
                    SafeSampleKey("O");  'turn on opto
                    tOpt := View(DataWindow%).MaxTime();
                    printlog("OptoOn at %f\n",tOpt);
                    SampleText("OptoOn",tOpt);  'Sampletext is approximate, opto copy channel will have record of TTL pulse
                    optoIsOn% := 1;  'Prevent opto from being turned on again
                endif
                
                DrawTarget(0,0,0);
                
                ChangeStateTo(stateWaitForSaccadeRelease%, tTrigger);
            endif
        endif 
        
    '----////----\\\\----////----\\\\----////----\\\\--State Break!!--////----\\\\----////----\\\\----////----\\\\
        
    case iState% = stateWaitForSaccadeRelease% then 
        ' Fixation may be broken while waiting for saccade release
        if LookingFixation%(xEye,yEye) <= 0 then
            LogStatus("WaitForSaccadeRelease", "Broken fixation at about " + str$(tNow));
            ChangeStateTo(stateAbort%, tNow);
        else
            if (tNow - tStateStart >= laSaccadeReleaseDelay) then  'Wait done
                'Turn off opto if requested at this stage - if it's on and it stops at this stage, STOP!
                if laDoOptoThisTrial% = 1 and  optoIsOn% = 1 and optoOffState% = stateWaitForSaccadeRelease% then
                    LogStatus("WaitForSaccadeRelease", "Request opto off at about " + str$(tNow));
                    SafeSampleKey("o");  'turn off opto
                    tOpt := View(DataWindow%).MaxTime();
                    printlog("OptoOff at %f\n",tOpt);
                    SampleText("OptoOff",tOpt);  'Sampletext is approximate, opto copy channel will have record of TTL pulse
                    optoIsOn% := 0;
                endif
                                
                'Remove fixpt, and allow saccade
                SafeSampleKey("f");
                if laDoMicroThisTrial% = 1 then
                    WaitForFixptOffTo(stateGiveMicrostim%, tNow); 
                else
                    WaitForFixptOffTo(stateWaitSaccade1%, tNow);
                endif
                
            endif
        endif; 
        

        'TODO Code for some eye-trace stuff, haven't looked hard at it, not sure we'll use it, but not deleting until I know I don't need anything like this
        'iStarPosColor% := GetEyeTraceColor%(starTargetOrder%[iTargetPoint%]);
        'iStarPosChannel% := View(StarWindow%).XYSetChan(0, 0, 0, 1, iStarPosColor%);
        'if iStarPosChannel% > 0 then
        '    View(StarWindow%).XYDrawMode(iStarPosChannel%, 1, 0);
        '    View(StarWindow%).XYDrawMode(iStarPosChannel%, 2, 0);
        'endif          
        
    '----////----\\\\----////----\\\\----////----\\\\--State Break!!--////----\\\\----////----\\\\----////----\\\\
        
    case iState% = stateWaitSaccade1% then
        if stateBegin% = 1 then
            'Turn on opto if requested at this stage - if it's not on and it starts at this stage, GO!
            if laDoOptoThisTrial% = 1 and  optoIsOn% = 0 and optoOnState% = stateWaitSaccade1% then
                LogStatus("WaitSaccade1", "Request opto on at about " + str$(tNow));
                SafeSampleKey("O");  'turn on opto
                tOpt := View(DataWindow%).MaxTime();
                printlog("OptoOn at %f\n",tOpt);
                SampleText("OptoOn",tOpt);  'Sampletext is approximate, opto copy channel will have record of TTL pulse
                optoIsOn% := 1;  'Prevent opto from being turned on again
            endif
            LogStatus("WaitSaccade1", "Ready for Saccade 1 at about " + str$(tNow));
            SampleText("Waiting for Saccade 1",tNow);
            stateBegin% := 0;
        endif
        
        'Note that no matter what we will turn off opto before leaving this state.  Opto is done at this point in the expt.
        
        looking% := LookingTarget1%(xEye,yEye,tc%);
        if looking% > 0 then   'if looking at any present S1 target, "saccade" has happened 
            
            'Turn off opto if requested at this stage - if it's on and it stops at this stage, STOP!
            'Actually, if opto is on at this point, TURN IT OFF.  This does cover the case of the GNG experiment
            'where opto during the S2 is allowed, as well
            if laDoOptoThisTrial% = 1 and  optoIsOn% = 1 then 'and optoOffState% = stateWaitSaccade1% then
                LogStatus("Saccade1Done", "Request opto off at about " + str$(tNow));
                SafeSampleKey("o");  'turn off opto
                tOpt := View(DataWindow%).MaxTime();
                printlog("OptoOff at %f\n",tOpt);
                SampleText("OptoOff",tOpt);  'Sampletext is approximate, opto copy channel will have record of TTL pulse
                optoIsOn% := 0;
            endif
            
            if looking% = laTarget1Loc%[tc%] then  'potential hit, have to hold
                LogStatus("WaitSaccade1", "Entered target answer window at about " + str$(tNow));
                SampleText("Saccade 1 Target Window Entered at about",tNow); 
                ChangeStateTo(stateHoldSaccade1%, tNow);
            else
                'this is looking at the wrong target, a miss, do not require hold time
                LogStatus("WaitSaccade1", "Entered nontarget answer window at about " + str$(tNow));
                SampleText("Nontarget Window Entered at about",tNow); 
                ChangeStateTo(stateFailure%, tNow);
            endif

        else
            
            'Midstream opto off not currently envisioned            
            '            'Turn off opto mid stream, if required
            '            if tNow - tStateStart >= starOptoOffMidStimTime  and optoIsOn% = 1 then
            '                LogStatus("WaitForAnswer", "Turning off laser at " + str$(tNow));
            '                'do not change state
            '                'turn off opto
            '                SafeSampleKey("o");  'turn it off
            '                tOpt := View(DataWindow%).MaxTime();
            '                'printlog("OptoOff at %f\n",tOpt);
            '                SampleText("OptoOff",tOpt);
            '                optoIsOn% := 0;
            '            endif;           
            
            if tNow - tStateStart >= laSacc1AcqTime then  'if saccade fails
                
                'Turn off opto if requested at this stage - if it's on and it stops at this stage, STOP!
                'Actually, if opto is on at this point, TURN IT OFF
                if laDoOptoThisTrial% = 1 and  optoIsOn% = 1 then 'and optoOffState% = stateWaitSaccade1% then
                    LogStatus("Saccade1Fail", "Request opto off at about " + str$(tNow));
                    SafeSampleKey("o");  'turn off opto
                    tOpt := View(DataWindow%).MaxTime();
                    printlog("OptoOff at %f\n",tOpt);
                    SampleText("OptoOff",tOpt);  'Sampletext is approximate, opto copy channel will have record of TTL pulse
                    optoIsOn% := 0;
                endif
                
                LogStatus("WaitForSaccade1", "Saccade 1 Timeout Fail at " + str$(tNow));
                SampleText("Saccade 1 Timeout",tNow);
                ChangeStateTo(stateFailure%, tNow);
                
            endif
            
        endif
        
    '----////----\\\\----////----\\\\----////----\\\\--State Break!!--////----\\\\----////----\\\\----////----\\\\
        
    case iState% = stateHoldSaccade1% then
        'Re-check looking%
        looking% := LookingTarget1%(xEye,yEye,tc%);
        docase
        case looking% = laTarget1Loc%[tc%] and tNow > tStateStart+laSacc1HoldTime then  'held through entire time for saccade 1
            LogStatus("HoldAnswer", "Target 1 fully held at about " + str$(tNow));
            SampleText("Saccade 1 Success",tNow);
            
            'Give hold reward on success, if requested
            RewardSmall%(laPSmallRewardSaccade1);
            
            if laDoTwoSaccades% = 1 then  'move to second saccade
                if laFixDownAfterPage% < laTrialFinalPage% then  'If fixation is down but there are more pages to play, go to next page
                    'Logic is a bit complicated with all the possbilities but currently this ONLY goes to page 2 so we don't have to check expt/training stage
                    if laFixDownAfterPage% = 1 then
                        SafeSampleKey("v");  'Request page 2
                        ChangeStateTo(stateWaitForPage2Up%,tNow);
                    else
                        'Sanity check, if this triggers we should find it in testing
                        Message("After Saccade 1, laFixDownAfterPage was expected\n to be 1, but was " + Str$(laFixDownAfterPage%) + ", quitting!");
                        Halt;
                    endif                    
                else 'fixation is down and there are no more pages to play
                    'Under current logic, we are now released to do the second saccade (first saccade hold needs to be short, but it is the only thing, there is no release signal!)
                    ChangeStateTo(stateWaitSaccade2%,tNow);
                    tSaccadeStart := 0;
                endif
                
            else  'success!
                ChangeStateTo(stateSuccess%, tNow);
            endif   
        case looking% <> laTarget1Loc%[tc%] then  'broke fixation on target 1 early
            LogStatus("Hold Answer", "Target 1 hold broken at about " + str$(tNow));
            ChangeStateTo(stateFailure%, tNow);
        endcase

    '----////----\\\\----////----\\\\----////----\\\\--State Break!!--////----\\\\----////----\\\\----////----\\\\
        
    case iState% = stateWaitSaccade2% then
        if stateBegin% = 1 then
            'No more opportunity for opto
            LogStatus("WaitSaccade2", "Ready for Saccade 2 at about " + str$(tNow));
            SampleText("Waiting for Saccade 2",tNow);
            stateBegin% := 0;
        endif
        
        if laDoOptoThisTrial% = 1 then
            looking% := LookingTarget2JAWS%(xEye,yEye,tc%);
        else
            looking% := LookingTarget2%(xEye,yEye,tc%);
        endif
        docase
        case looking% = 1 then  'Gaze has not left first target
            if tNow - tStateStart >= laSacc1AcqTime then  'if saccade fails
                LogStatus("WaitForSaccade2", "Saccade 2 Timeout Fail at " + str$(tNow));
                SampleText("Saccade 2 Timeout",tNow);
                ChangeStateTo(stateFailure%, tNow);
            endif
        case looking% = 0 and tSaccadeStart = 0 then 'first time we notice gaze has left Targ 1, allow an extra ~300 ms (saccadeMaxDur) to find target  
            tSaccadeStart := tNow;
            LogStatus("WaitForSaccade2", "Gaze left Target 1 before " + str$(tNow) + " but no target acquired yet");
            'Stay in this state
        case looking% = 0 and tSaccadeStart > 0 then 'gaze already left Targ 1 and the very short "saccade clock" is ticking
            if tNow - tStateStart >= saccadeMaxDur then  'if saccade fails
                LogStatus("WaitForSaccade2", "Saccade 2 Timeout Fail at " + str$(tNow));
                SampleText("Saccade 2 Timeout",tNow);
                ChangeStateTo(stateFailure%, tNow);
            endif
        case looking% > 1 then   'a saccade has happened to a target
            if looking% = laTarget2Loc%[tc%] then  'potential hit, have to hold
                LogStatus("WaitSaccade2", "Entered target answer window at about " + str$(tNow));
                SampleText("Saccade 2 Target Window Entered at about",tNow); 
                ChangeStateTo(stateHoldSaccade2%, tNow);
            else
                'this is looking at the wrong target, a miss, do not require hold time
                LogStatus("WaitSaccade2", "Entered nontarget answer window at about " + str$(tNow));
                SampleText("Nontarget Window Entered at about",tNow); 
                ChangeStateTo(stateFailure%, tNow);
            endif            
        endcase  
        
    '----////----\\\\----////----\\\\----////----\\\\--State Break!!--////----\\\\----////----\\\\----////----\\\\
        
    case iState% = stateHoldSaccade2% then
        'Re-check looking%
        if laDoOptoThisTrial% = 1 then
            looking% := LookingTarget2JAWS%(xEye,yEye,tc%);
        else
            looking% := LookingTarget2%(xEye,yEye,tc%);
        endif
        docase
        case looking% = laTarget2Loc%[tc%] and tNow > tStateStart+laSacc2HoldTime then  'held through entire time for saccade 1
            LogStatus("HoldAnswer", "Target 2 fully held at about " + str$(tNow));
            SampleText("Saccade 2 Success",tNow);
            ChangeStateTo(stateSuccess%, tNow);
        case looking% <> laTarget2Loc%[tc%] then  'broke fixation on target 2 early
            LogStatus("Hold Answer", "Target 2 hold broken at about " + str$(tNow));
            ChangeStateTo(stateFailure%, tNow);
        endcase
        
    '----////----\\\\----////----\\\\----////----\\\\--State Break!!--////----\\\\----////----\\\\----////----\\\\
        
    case iState% = stateGiveMicrostim% then    
        'TODO - here we have to actually give the microstimulation
        'We will get to this state immediately after verification 
        'that the fixation point has come down, regardless of where
        'in the page structure we are (i.e. page 1 or page 2, based
        'on training step).  Note that if we do NOT give microstim 
        'on a particular trial we will simply wait for Saccade 1,
        'which is correct.
        
        'Right now this state will just advance to the next state so AlwaysLooking testing is possible
        
        'LogStatus("Give Microstim", "Deliver microstim at about " + str$(tNow));
        LogStatus("Give Microstim", "PLACEHOLDER -- Deliver microstim at about " + str$(tNow));
        
        'Give the microstim!  No idea how the hardware will work for now
        
        ChangeStateTo(stateWaitSaccadeMicro%, tNow);  'TODO - Is it possible we just go to WaitSaccade1 here????
        
    '----////----\\\\----////----\\\\----////----\\\\--State Break!!--////----\\\\----////----\\\\----////----\\\\
        
    case iState% = stateWaitSaccadeMicro% then
        'TODO - the logic of this one is also a bit fuzzy
        'Leave the logic to be worked out when the hardware 
        'exists.  Perhaps it's no different than Saccade 1
        
        'Right now this state will just advance to the next state so AlwaysLooking testing is possible
        
        'LogStatus("Wait Microstim Saccade", "Microstim saccade at about " + str$(tNow));
        LogStatus("Wait Microstim Saccade", "PLACEHOLDER -- Microstim saccade at about " + str$(tNow));
        
        ChangeStateTo(stateWaitSaccade1%, tNow);
        
        'The JAWS issue is that we can't rely on the saccade
        'to be correct!  We have to randomly reward the
        'animal, but at what time we do that is not clear.
        'We might need to monitor for "any saccade", or at
        'least "any saccade" in the right direction.  
        
    '----////----\\\\----////----\\\\----////----\\\\--State Break!!--////----\\\\----////----\\\\----////----\\\\
        
    case iState% = stateSuccess% then
        'This should not happen, but can't be too careful!  Make sure opto is off!
        if optoIsOn% = 1 then
            LogStatus("StateSuccess", "OPTO STILL ON!  Request opto off at about " + str$(tNow));
            SafeSampleKey("o");  'turn off opto
            tOpt := View(DataWindow%).MaxTime();
            printlog("OptoOff at %f\n",tOpt);
            SampleText("OptoOff",tOpt);  'Sampletext is approximate, opto copy channel will have record of TTL pulse
            optoIsOn% := 0;
            message("WARNING - opto was still on at stateSuccess%!  This should NOT happen!\n  There is a coding issue, please discontinue experiment and tell Jeff!");
        endif;
        
        'Note trial success and recalculate pctSuccess
        nTrialsSuccess% += 1;
        if laDoOptoThisTrial% = 1 then
            nTrialsSuccessJAWS% += 1;
        else
            nTrialsSuccessNoJAWS% += 1;
        endif
        pctSuccessJAWS := round(nTrialsSuccessJAWS%)/round(nTrialsStartedJAWS%-nTrialsAbortJAWS%);  'ROUND() is an undocumented floating-point math trick!
        pctSuccessNoJAWS := round(nTrialsSuccessNoJAWS%)/round(nTrialsStartedNoJAWS%-nTrialsAbortNoJAWS%);
        
        SafeSampleKey("X");
        Yield();
        
        'For now we are not doing a separate state for Reward
        'Reward on JAWS trials needs to be contingent
        'Here, we are in the "success" state, but it's possible that the window is too big and we don't want to
        'give "too easy" reward
        if laDoOptoThisTrial% = 1 then
            'First, determine what our reward probability should be
            jtc% := nTrialsStartedNoJAWS%-nTrialsAbortNoJAWS%;  'Total completed JAWS trials
            if jtc% < 40 then
                'using 40 trial window to blend laPJawsRewardInit with actual success on No-JAWS trials
                laPJawsReward := (laPJawsRewardInit*round(40-jtc%)/40) + (pctSuccessNoJAWS*round(jtc%/40));  
            else
                'After 40 trial window, just use actual No-JAWS success rate
                laPJawsReward := pctSuccessNoJAWS;
            endif
            'Now we want to reward if JAWS success is less than No-JAWS, but randomly not-reward if JAWS success is too high
            if pctSuccessJAWS < laPJawsReward then
                SampleText("Trial " + Str$(tc%) + " Success, giving reward!");
                DefaultReward%();
            else
                if (laPJawsReward/pctSuccessJAWS) >= Rand() then
                    SampleText("Trial " + Str$(tc%) + " Success, giving reward!");
                    DefaultReward%();
                else
                    SampleText("Trial " + Str$(tc%) + " Success, no reward (window may be too large)!");
                endif
            endif            
        else
            SampleText("Trial " + Str$(tc%) + " Success, giving reward!");
            DefaultReward%();  'On regular trials, reward
        endif
        
        WaitForBlankTo(stateAdvance%, tNow); 
        
    '----////----\\\\----////----\\\\----////----\\\\--State Break!!--////----\\\\----////----\\\\----////----\\\\
        
    case iState% = stateFailure% then
        'This should not happen, but can't be too careful!  Make sure opto is off!
        if optoIsOn% = 1 then
            LogStatus("StateFailure", "OPTO STILL ON!  Request opto off at about " + str$(tNow));
            SafeSampleKey("o");  'turn off opto
            tOpt := View(DataWindow%).MaxTime();
            printlog("OptoOff at %f\n",tOpt);
            SampleText("OptoOff",tOpt);  'Sampletext is approximate, opto copy channel will have record of TTL pulse
            optoIsOn% := 0;
            message("WARNING - opto was still on at stateFailure%!  This should NOT happen!\n  There is a coding issue, please discontinue experiment and tell Jeff!");
        endif;
        
        'Note trial failure and recalculate pctSuccess (nTrialsStarted has changed)
        nTrialsFail% += 1;
        if laDoOptoThisTrial% = 1 then
            nTrialsFailJAWS% += 1;
        else
            nTrialsFailNoJAWS% += 1;
        endif
        pctSuccessJAWS := round(nTrialsSuccessJAWS%)/round(nTrialsStartedJAWS%-nTrialsAbortJAWS%);  'ROUND() is an undocumented floating-point math trick!
        pctSuccessNoJAWS := round(nTrialsSuccessNoJAWS%)/round(nTrialsStartedNoJAWS%-nTrialsAbortNoJAWS%);
        
        'For the moment, I don't think we should try to implement any sort of reward-on-failure for JAWS trials, 
        'but this will obviously be up for discussion when we get around to the double-saccade task, particularly 
        'if failure rate on JAWS trials is very high, but the animal IS saccading somewhere (just not where we
        'expected).
        
        SampleText("Trial " + Str$(tc%) + " Failure");

        SafeSampleKey("X");
        WaitForBlankTo(stateAdvance%, tNow); 
        
    '----////----\\\\----////----\\\\----////----\\\\--State Break!!--////----\\\\----////----\\\\----////----\\\\
         
    case iState% = stateAbort% then
        'Note trial abort; do not recalculate pctSuccess as it doesn't change on an abort
        nTrialsAbort% += 1;
        if laDoOptoThisTrial% = 1 then
            nTrialsAbortJAWS% += 1;
        else
            nTrialsAbortNoJAWS% += 1;
        endif
        'isAbort% := 1;  'Unused


        'There are multiple places that can lead to an abort with opto laser still on, turn this off FIRST
        if optoIsOn% = 1 then
            'turn off opto
            SafeSampleKey("o");  'turn it off
            tOpt := View(DataWindow%).MaxTime();
            printlog("OptoOff at %f\n",tOpt);
            SampleText("OptoOff",tOpt);  'Sampletext is approximate, opto copy channel will have record of TTL pulse
            optoIsOn% := 0;
        endif;
        
        SampleText("Trial " + Str$(tc%) + " Abort");
        SafeSampleKey("X");   'Request all stimuli down
        
        WaitForBlankTo(stateAbortPenalty%, tNow);
        
    '----////----\\\\----////----\\\\----////----\\\\--State Break!!--////----\\\\----////----\\\\----////----\\\\
        
    case iState% = stateAbortPenalty% then 
        if stateBegin% = 1 then 
            LogStatus("StateAbort Penalty", "Abort Penalty begun at about " + str$(tNow));
            stateBegin% := 0;
        endif
        
        if (tNow - tStateStart >= laAbortPenaltyTime) then
            ChangeStateTo(stateITI%, tNow);  'don't go to reward
        endif;       
        
    '----////----\\\\----////----\\\\----////----\\\\--State Break!!--////----\\\\----////----\\\\----////----\\\\
        
    case iState% = stateAdvance% then    
        SafeSampleKey("a");
        LogStatus("Advance", "Requesting advance at about " + str$(tNow));
        ChangeStateTo(stateCheckAdvance%,tNow);
        
    '----////----\\\\----////----\\\\----////----\\\\--State Break!!--////----\\\\----////----\\\\----////----\\\\
        
    case iState% = stateCheckAdvance% then
        'Checking that previously-requested advance has occurred
        if stateBegin% = 1 then
            LogStatus("CheckAdvance", "Checking that advance has occured at about " + str$(tNow));
            stateBegin% := 0;
        endif
        
        'The Advance channel will toggle, we don't care whether the edge is up or down
        if FindEdge%(AdvanceChannel%, tLastAdvance+tic, tAdvance) > -1 then
            LogStatus("CheckAdvance", "Advance occured at exactly " + str$(tAdvance));
            SampleText("Stimulus Advanced",tAdvance);
            ChangeStateTo(stateITI%,tStateStart);  'We don't want to count the advance time against the ITI
            tLastAdvance := tAdvance;
        endif        
        
    '----////----\\\\----////----\\\\----////----\\\\--State Break!!--////----\\\\----////----\\\\----////----\\\\
        
    case iState% = stateITI% then
        'Waiting for ITI to end
        if stateBegin% = 1 then
            stateBegin% := 0;
            LogStatus("WaitThrough ITI", "Began waiting through ITI at about " + str$(tNow));
            UpdateToolbarText();  'This is relatively simplistic but that should be OK
        endif
        
        if (tNow - tStateStart >= laInterTrialTime) then
            ChangeStateTo(stateStartTrial%, tNow);
        endif;
        
    '----////----\\\\----////----\\\\----////----\\\\--State Break!!--////----\\\\----////----\\\\----////----\\\\
        
    'Special case - can only get here using WaitForBlankTo(), which specifies the next state to go to
    case iState% = stateWaitForBlank% then  
        'Waiting for screen blank
        if stateBegin% = 1 then
            stateBegin% := 0;
            tLast := tStateStart;  'This may not make a big difference, actually
            LogStatus("WaitForBlank", "Began waiting for blank screen at about " + str$(tNow));
        endif
        
        if View(DataWindow%).FindFallingEdge%(StimChannel%, tLast, tTrigger) = 1 then
            'Stimulus is down
            'tLastTrigger := tTrigger;  'unused
            LogStatus("WaitForBlank", "Blank screen at exactly " + str$(tTrigger));
            SampleText("Screen Blank",tTrigger);
            DrawTarget(0,0,0);  'Remove targets, second and third arguments are ignored
            DrawFix(0);
            ChangeStateTo(nextState%,tTrigger);  'It doesn't really matter which time we use here, none of the states following the "X" depend crucially on knowing the time of any previous action
        endif        
        
    '----////----\\\\----////----\\\\----////----\\\\--State Break!!--////----\\\\----////----\\\\----////----\\\\
        
    'Special case - can only get here using WaitForFixptOffTo(), which specifies the next state to go to
    case iState% = stateWaitForFixptOff% then  
        'Waiting for fixpt off
        if stateBegin% = 1 then
            tLast := tStateStart;  'This may not make a big difference, actually
            LogStatus("WaitForFixptOff", "Began waiting for fixpt off at about " + str$(tNow));
            stateBegin% := 0;
        endif
        
        if View(DataWindow%).FindFallingEdge%(FixPointChannel%, tLast, tTrigger) = 1 then
            'Fixpt is off
            'tLastTrigger := tTrigger;  'unused
            LogStatus("WaitForFixptOff", "Fixpt down at exactly " + str$(tTrigger));
            SampleText("Fixpt Down",tTrigger);
            DrawFix(0);
            ChangeStateTo(nextState%,tTrigger);   'The fixation point going down is the start point here
        endif        
        
    '----////----\\\\----////----\\\\----////----\\\\--State Break!!--////----\\\\----////----\\\\----////----\\\\
        
    else 
        
        'Unknown state!
        'This should never happen, but it is BAD
        
        'First thing turn off the opto if it is on
        if optoIsOn% = 1 then
            'turn off opto
            SafeSampleKey("o");  'turn it off
            tOpt := View(DataWindow%).MaxTime();
            printlog("OptoOff at %f\n",tOpt);
            SampleText("OptoOff",tOpt);
            optoIsOn% := 0;
        endif;
        
        'If the eyetracker is recording an output file, stop recording and close the file
        if RecordEyeTrackerOutputFile% = 1 then
            SafeSampleKey("w");  'Stop recording
            yield(0.1);
            SafeSampleKey("i");  'Close the file
            SafeSampleKey("Z");  'zero the DIGLOWs
        endif
        
        'Then put up a message indicating the issue
        Message("Unknown state (Value is " + str$(iState%) + "), Quitting!");
        
        halt;
        
    endcase;
    
    
    
    tLast := tNow;
	
	return iStatus%;
    
end;



'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
proc ChangeStateTo(stateTo%, tStart)
	iState% := stateTo%;
    if iState% = stateWaitForBlank% then  'this is not allowed and is a coding error, must use WaitForBlankTo()
        message("Coding error - disallowed ChangeStateTo(stateWaitForBlank%,...)!  Quitting!");
        halt;  'Coding error, this won't happen live, we'll catch it in testing if we accidentally do it 
    endif
    stateBegin% := 1;  'Reset for next state
	if tStart > 0 then 
        tStateStart := tStart; 
    endif;
end;



'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
'WaitForBlankTo() - this is essentially the same as ChangeStateTo(), except it goes to an intermediate
'state which waits for a screen blank and THEN goes to the specified state.  stateWaitForBlank is an unusual
'state in that it can be called in a lot of contexts, which justifies an easier way of keeping track of
'which state we want to go to next
proc WaitForBlankTo(stateTo%, tStart)
	nextState% := stateTo%;
    stateBegin% := 1;  'Reset for next state
    iState% := stateWaitForBlank%;
	if tStart > 0 then 
        tStateStart := tStart; 
    endif;
end;


'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
'WaitForFixptOffTo() - this is essentially the same as ChangeStateTo(), except it goes to an intermediate
'state which waits for fixpt down and THEN goes to the specified state.  stateWaitForFixptOff is an unusual
'state in that it can be called in a lot of contexts, which justifies an easier way of keeping track of
'which state we want to go to next
proc WaitForFixptOffTo(stateTo%, tStart)
	nextState% := stateTo%;
    stateBegin% := 1;  'Reset for next state
    iState% := stateWaitForFixptOff%;
	if tStart > 0 then 
        tStateStart := tStart; 
    endif;
end;





proc GetLookAwayExperimentType()
	var stmp$;
	var key$;
	key$:="AlertRig\\" + GetCurrentConfiguration$() + "\\Scripts\\LookAway";
    
    laExperimentType% := GetIntRegistryValue%(key$, "ExperimentType", laExperimentType%);
    laTrainingStageSSGNG% := GetIntRegistryValue%(key$, "TrainingStageSSGNG", laTrainingStageSSGNG%);
    laTrainingStageSSMicro% := GetIntRegistryValue%(key$, "TrainingStageSSMicro", laTrainingStageSSMicro%);
    laTrainingStageDS2S1% := GetIntRegistryValue%(key$, "TrainingStageDS2S1", laTrainingStageDS2S1%);
    laTrainingStageDS2S2% := GetIntRegistryValue%(key$, "TrainingStageDS2S2", laTrainingStageDS2S2%);
    
end;

proc SaveLookAwayExperimentType()
	var key$;
	var stmp$;
	key$:="AlertRig\\" + GetCurrentConfiguration$() + "\\Scripts\\LookAway";
    
    SetIntRegistryValue(key$, "ExperimentType", laExperimentType%);
    SetIntRegistryValue(key$, "TrainingStageSSGNG", laTrainingStageSSGNG%);
    SetIntRegistryValue(key$, "TrainingStageSSMicro", laTrainingStageSSMicro%);
    SetIntRegistryValue(key$, "TrainingStageDS2S1", laTrainingStageDS2S1%);
    SetIntRegistryValue(key$, "TrainingStageDS2S2", laTrainingStageDS2S2%);
    
end;    


